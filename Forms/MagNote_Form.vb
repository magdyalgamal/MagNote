    Private Sub Unlock_BitLocker_Btn_Click(sender As Object, e As EventArgs) Handles Unlock_BitLocker_Btn.Click
        PasswordTextDisplayed = Microsoft.VisualBasic.DateAndTime.Timer + 60
        If String.IsNullOrEmpty(EnteredPassword) Then
            If Language_Btn.Text = "E" Then
                Msg = "لم تقم بإدخال كلمة السر الرئيسية للمرور بعد"
            Else
                Msg = "You Did Not Enter The Main Password To Log In"
            End If
            ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1, MBOs, False)
            Exit Sub
        End If
        If BitLocker_Drive_Password_TxtBx.UseSystemPasswordChar Then
            BitLocker_Drive_Password_TxtBx.UseSystemPasswordChar = False
            BitLocker_Drive_Password_TxtBx.PasswordChar = Nothing
            BitLocker_Drive_Password_TxtBx.Multiline = True
        ElseIf BitLocker_Drive_CmbBx.SelectedIndex <> -1 And
            BitLocker_Drive_Password_CmbBx.SelectedIndex <> -1 And
            BitLocker_Drive_Password_TxtBx.BackColor = Color.Green And
            BitLocker_Drive_Password_TxtBx.TextLength > 0 Then
            UnlockBitLockerDrive(BitLocker_Drive_CmbBx.SelectedItem, DirectCast(BitLocker_Drive_Password_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Value)
        ElseIf BitLocker_Drive_CmbBx.SelectedIndex <> -1 And
            BitLocker_Drive_Password_CmbBx.SelectedIndex <> -1 And
            BitLocker_Drive_Password_TxtBx.BackColor <> Color.Green And
            BitLocker_Drive_Password_TxtBx.TextLength > 0 Then
            If Language_Btn.Text = "E" Then
                Msg = "كلم السر التى ادخلتها مخالفة لتلك المحفوظة... هل تريد التعديل؟"
            Else
                Msg = "The Password You Entered Is Different Than The Saved One... Do You Want To Change It?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                Exit Sub
            End If
            BitLocker_Drive_Password_CmbBx.Items.Remove(BitLocker_Drive_Password_CmbBx.SelectedItem)
            BitLocker_Drive_Password_CmbBx.Items.Add(New KeyValuePair(Of String, String)(BitLocker_Drive_CmbBx.SelectedItem, BitLocker_Drive_Password_TxtBx.Text))
            Save_Note_Form_Parameter_Setting_Btn_Click(Save_Note_Form_Parameter_Setting_Btn, EventArgs.Empty)
        ElseIf BitLocker_Drive_CmbBx.SelectedIndex <> -1 And
            BitLocker_Drive_Password_CmbBx.SelectedIndex = -1 And
            BitLocker_Drive_Password_TxtBx.BackColor <> Color.Green And
            BitLocker_Drive_Password_TxtBx.TextLength > 0 Then
            If Language_Btn.Text = "E" Then
                Msg = "محرك الاقراص التى اخترته غير مسجل له كلمة سر بعد... هل تريد التسجيل؟"
            Else
                Msg = "The Drive You Select Has No Password Saved Yet... Do You Want To Save It?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                Exit Sub
            End If
            BitLocker_Drive_Password_CmbBx.Items.Add(New KeyValuePair(Of String, String)(BitLocker_Drive_CmbBx.SelectedItem, BitLocker_Drive_Password_TxtBx.Text))
            Save_Note_Form_Parameter_Setting_Btn_Click(Save_Note_Form_Parameter_Setting_Btn, EventArgs.Empty)
        ElseIf BitLocker_Drive_Password_TxtBx.TextLength = 0 And
                  BitLocker_Drive_CmbBx.SelectedIndex <> -1 And
                  BitLocker_Drive_Password_CmbBx.SelectedIndex <> -1 Then
            If Language_Btn.Text = "E" Then
                Msg = "هل تريد إلغاء محرك الاقراص التى اخترته من بيانات البيتلوكر؟"
            Else
                Msg = "Do You Want To Remove The Drive You Selected From BitLocker Data?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.Yes Then
                BitLocker_Drive_Password_CmbBx.Items.Remove(BitLocker_Drive_Password_CmbBx.SelectedItem)
                Save_Note_Form_Parameter_Setting_Btn_Click(Save_Note_Form_Parameter_Setting_Btn, EventArgs.Empty)
            End If
        ElseIf Not BitLocker_Drive_Password_TxtBx.UseSystemPasswordChar Then
            BitLocker_Drive_Password_TxtBx.UseSystemPasswordChar = True
            BitLocker_Drive_Password_TxtBx.Multiline = False
        End If
    End Sub

