        Try
            Cursor = Cursors.WaitCursor
            If IgnoreReadFile Or Not File.Exists(fil) Then Exit Function
            Dim MagNote_Name_Value,
                    MagNote_Label_Value,
                    MagNote_Category_Value,
                    MagNote_Value,
                    Blocked_Note_Value,
                    Finished_Note_Value,
                    Note_Font_Value,
