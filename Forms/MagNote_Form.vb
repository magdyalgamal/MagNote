            Note_Password_TxtBx.Text = Nothing
            'If ActiveControl.Name <> Available_MagNotes_DGV.Name Then
            Note_Font_Color_ClrCmbBx.SelectedItem = External_Note_Font_Color_ClrCmbBx.SelectedItem
            Note_Back_Color_ClrCmbBx.SelectedItem = External_Note_Back_Color_ClrCmbBx.SelectedItem
            Alternating_Row_Color_ClrCmbBx.SelectedItem = External_Note_Alternating_Row_Color_ClrCmbBx.SelectedItem
            Note_Font_Name_CmbBx.Text = External_Note_Font_Name_CmbBx.Text
            Note_Font_Style_CmbBx.Text = External_Note_Font_Style_CmbBx.Text
            Note_Font_Size_CmbBx.Text = External_Note_Font_Size_CmbBx.Text
