    Dim CursorPoint As Point
    Dim TabPageToClose As TabPage
    Private isDragging As Boolean = False
    Private draggedTab As TabPage = Nothing
    Private Sub MagNotes_Notes_TbCntrl_MouseDown(sender As Object, e As MouseEventArgs) Handles MagNotes_Notes_TbCntrl.MouseDown
        If e.Button = MouseButtons.Right Then
            TabPageToClose = New TabPage
            For Each TbPg In MagNotes_Notes_TbCntrl.TabPages
                If MagNotes_Notes_TbCntrl.GetTabRect(MagNotes_Notes_TbCntrl.TabPages.IndexOf(TbPg)).Contains(e.X, e.Y) Then
                    TabPageToClose = TbPg
                    Exit For
                End If
            Next
        Else
            MagNotes_Notes_TbCntrl.Cursor = Cursors.SizeAll
            For i As Integer = 0 To MagNotes_Notes_TbCntrl.TabPages.Count - 1
                If MagNotes_Notes_TbCntrl.GetTabRect(i).Contains(e.Location) Then
                    ' Start dragging
                    isDragging = True
                    draggedTab = MagNotes_Notes_TbCntrl.TabPages(i)
                    Exit For
                End If
            Next
        End If
    End Sub
    Private Sub MagNotes_Notes_TbCntrl_MouseUp(sender As Object, e As MouseEventArgs) Handles MagNotes_Notes_TbCntrl.MouseUp
        ' End dragging
        Try
            If isDragging AndAlso draggedTab IsNot Nothing Then
                ' Check if we are over another tab and move the dragged tab
                For i As Integer = 0 To MagNotes_Notes_TbCntrl.TabPages.Count - 1
                    Dim rect = MagNotes_Notes_TbCntrl.GetTabRect(i)
                    If rect.Contains(e.Location) AndAlso MagNotes_Notes_TbCntrl.TabPages(i) IsNot draggedTab Then
                        ' Swap the positions of the dragged tab and the current tab
                        Dim draggedIndex As Integer = MagNotes_Notes_TbCntrl.TabPages.IndexOf(draggedTab)
                        Dim targetIndex As Integer = i

                        MagNotes_Notes_TbCntrl.TabPages.Remove(draggedTab)
                        MagNotes_Notes_TbCntrl.TabPages.Insert(targetIndex, draggedTab)
                        MagNotes_Notes_TbCntrl.SelectedTab = draggedTab
                        Exit For
                    End If
                Next
            End If
        Catch ex As Exception
        Finally
            MagNotes_Notes_TbCntrl.Cursor = Cursors.Default
            isDragging = False
            draggedTab = Nothing
        End Try
    End Sub

