    Private Function ChangeMagNoteEncryptionKey() As Boolean
        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Dim OpenNoteInNewTabChkBx As CheckState = Open_Note_In_New_Tab_ChkBx.CheckState
        Dim ProgressToAdd
        Try
            Dim MagNotes() As String = Nothing
            Dim OldEncryptionKey = EncryptionKey
            Dim NewEncryptionKey = Encryption_Key_TxtBx.Text
            If Update_Only_Opened_TabPages_Encryption_Key_ChkBx.CheckState = CheckState.Checked Then
                EncryptionKey = NewEncryptionKey
                ApplicationDoEvents(Me)
                ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, MagNotes_Notes_TbCntrl.TabPages.Count)
                For Each TbPg In MagNotes_Notes_TbCntrl.TabPages
                    progress += ProgressToAdd
                    Previewlbl.Text = "ReEncrypt--> " & TbPg.text & vbNewLine & Math.Floor(progress * 100)
                    Previewlbl.Refresh()
                    Previewlbl.Invalidate()
                    If Not File.Exists(TbPg.name) Then
                        Continue For
                    End If
                    MagNotes_Notes_TbCntrl.SelectedTab = TbPg
                    ApplicationDoEvents(Me)
                    Save_Note_TlStrpBtn_Click(Save_Note_TlStrpBtn, EventArgs.Empty, 1)
                Next
                EncryptionKey = OldEncryptionKey
                UseArgFile = String.Empty
                Return True
            Else
                MagNotes = Directory.GetFiles(MagNoteFolderPath, "MagNote -(*.txt", System.IO.SearchOption.TopDirectoryOnly)
            End If
            Open_Note_In_New_Tab_ChkBx.CheckState = CheckState.Unchecked
            For Each TbPg In MagNotes_Notes_TbCntrl.TabPages
                MagNotes_Notes_TbCntrl.TabPages.Remove(TbPg)
            Next
            ClearAvailable_MagNotes_DGV()
            New_Note_TlStrpBtn_Click(New_Note_TlStrpBtn, EventArgs.Empty, 1)
            Dim MagoteDGVRow As New DataGridViewRow
            Dim F, FileName
            ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, MagNotes.Count)
            For Each MagNoteFile In MagNotes
                If IsNothing(MagNoteFile) Then Continue For
                progress += ProgressToAdd
                Previewlbl.Text = "Loading--> " & MagNoteFile & vbNewLine & Math.Floor(progress * 100)
                Previewlbl.Refresh()
                Previewlbl.Invalidate()
                MagoteDGVRow = New DataGridViewRow
                F = Path.GetFileNameWithoutExtension(MagNoteFile)
                FileName = Microsoft.VisualBasic.Left(F, Len("MagNote -(")) & Microsoft.VisualBasic.Right(Path.GetFileName(F), 2)
                If Not Path.GetExtension(MagNoteFile) = ".txt" Or
                            FileName <> "MagNote -()-" Then
                    Continue For
                Else
                    Dim array() As String = ReadFile(MagNoteFile, 1)
                    Dim CellNo = 0
                    Dim Column As New DataGridViewTextBoxCell()
                    For Each Cell In array
                        If String.IsNullOrEmpty(Cell) Then
                            Cell = String.Empty
                        End If
                        Column = New DataGridViewTextBoxCell()
                        Column.Value = Cell
                        MagoteDGVRow.Cells.Add(Column)
                        CellNo += 1
                    Next
                End If
                EncryptionKey = OldEncryptionKey
                ReadFile(MagoteDGVRow.Cells(0).Value,, 1,,, 1)
                If Enter_Password_To_Pass_ChkBx.CheckState = CheckState.Checked And
                    Main_Password_TxtBx.TextLength > 0 Then
                    Note_Password_TxtBx.Text = Decrypt_Function(Available_MagNotes_DGV.CurrentRow.Cells("Note_Password").Value)
                End If
                EncryptionKey = NewEncryptionKey
                ApplicationDoEvents(Me)
                Save_Note_TlStrpBtn_Click(Save_Note_TlStrpBtn, EventArgs.Empty, 1)
            Next
            Return True
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False) ', 0,,,,,, 0)
        Finally
            Previewlbl.Dispose()
            Previewlbl.Dispose()
            Open_Note_In_New_Tab_ChkBx.CheckState = OpenNoteInNewTabChkBx
        End Try
    End Function

