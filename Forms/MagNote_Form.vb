    Private Sub SaveExternalParameters()
        Try
            Dim Parameters As String
            If Not File.Exists(MagNoteFolderPath & "\ExternalOpenFileParameters.xml") Then
                Parameters = "External_Note_Font_Value@Times New Roman:14:Regular,External_Note_Font_Color_Value@DarkBlue,External_Note_Back_Color_Value@LightBlue,External_Alternating_Row_Color_Value@Silver,Note_Form_Size_Value@{Width=1209:Height=791},Note_Form_Location_Value@{X=26:Y=26}"
            Else
                Parameters = "External_Note_Font_Value@" & DirectCast(External_Note_Font_Name_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Value & ":" & External_Note_Font_Size_CmbBx.Text & ":" & External_Note_Font_Style_CmbBx.Text
                Parameters &= ",External_Note_Font_Color_Value@" & External_Note_Font_Color_ClrCmbBx.Text
                Parameters &= ",External_Note_Back_Color_Value@" & External_Note_Back_Color_ClrCmbBx.Text
                Parameters &= ",External_Alternating_Row_Color_Value@" & External_Note_Alternating_Row_Color_ClrCmbBx.Text
                Parameters &= ",Note_Form_Size_Value@" & Replace(Replace(Note_Form_Size_TxtBx.Text, ",", ":"), " ", "")
                Parameters &= ",Note_Form_Location_Value@" & Note_Form_Location_TxtBx.Text.Replace(",", ":")
            End If

            Using XMLEditor As New XMLEditor("ExternalOpenFileParameters.xml", "ExternalParameters")
                Dim root = XMLEditor.doc.Element("ExternalParameters")
                root.RemoveAll() ' Remove existing alerts (optional: keep if you want to merge)
                For Each Parameter As String In Parameters.Split(",")
                    XMLEditor.Add(Parameter.Split("@").ToList(0),
                              New Dictionary(Of String, String) From {
                                  {"ParameterValue", Parameter.Split("@").ToList(1)}},
                              New Dictionary(Of String, String) From {
                                  {"ParameterValue", Parameter.Split("@").ToList(1)},
                                  {"Descreption", ""}}, 0)
                Next
                'XMLEditor.doc.Save(XMLEditor.filePath)
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

    Public Sub SetOpenedExternalAppParameters()
        Try
            If Not File.Exists(MagNoteFolderPath & "\ExternalOpenFileParameters.xml") Then
                SaveExternalParameters()
            End If
            Dim External_Note_Font_Value,
                    External_Note_Font_Color_Value,
                    External_Note_Back_Color_Value,
                    External_Alternating_Row_Color_Value,
                    Note_Form_Size_Value,
                    Note_Form_Location_Value
            Using XMLEditor As New XMLEditor("ExternalOpenFileParameters.xml", "ExternalParameters")
                Dim doc As XDocument = XMLEditor.doc
                For Each entry In doc.Root.Elements
                    Select Case entry.Name
                        Case "External_Note_Font_Value"
                            External_Note_Font_Value = entry.Element("ParameterValue").Value
                            Me.ActiveControl = Note_Font_Name_CmbBx
                            Note_Font_Name_CmbBx.Text = Split(External_Note_Font_Value, ":").ToList.Item(0)
                            Me.ActiveControl = Note_Font_Size_CmbBx
                            Note_Font_Size_CmbBx.Text = Split(External_Note_Font_Value, ":").ToList.Item(1)
                            Me.ActiveControl = Note_Font_Style_CmbBx
                            Note_Font_Style_CmbBx.Text = Split(External_Note_Font_Value, ":").ToList.Item(2)
                        Case "External_Note_Font_Color_Value"
                            Me.ActiveControl = Note_Font_Color_ClrCmbBx
                            Note_Font_Color_ClrCmbBx.Text = entry.Element("ParameterValue").Value
                        Case "External_Note_Back_Color_Value"
                            Me.ActiveControl = Note_Back_Color_ClrCmbBx
                            Note_Back_Color_ClrCmbBx.Text = entry.Element("ParameterValue").Value
                        Case "External_Alternating_Row_Color_Value"
                            Me.ActiveControl = Alternating_Row_Color_ClrCmbBx
                            Alternating_Row_Color_ClrCmbBx.Text = entry.Element("ParameterValue").Value
                        Case "Note_Form_Size_Value"
                            Note_Form_Size_TxtBx.Text = Replace(entry.Element("ParameterValue").Value, ":", ", ")
                            Me.Size = ReturnSize(Note_Form_Size_TxtBx.Text)
                        Case "Note_Form_Location_Value"
                            Note_Form_Location_Value = Replace(Replace(Replace(Replace(entry.Element("ParameterValue").Value, "{X=", ""), "Y=", ""), "}", ""), ":", ",")
                            If Not IsNothing(Note_Form_Location_Value) Then
                                If Not CheckFormLocation(Note_Form_Location_Value) Then
                                    Location = New Point(Split(Note_Form_Location_Value, ",").ToList(0), Split(Note_Form_Location_Value, ",").ToList(1))
                                End If
                            Else
                                Note_Form_Location_TxtBx.Text = "{X=0,Y=0}"
                            End If
                    End Select
                Next
                ApplicationDoEvents(Me)
                External_Note_Font_Name_CmbBx.SelectedItem = Note_Font_Name_CmbBx.SelectedItem
                External_Note_Font_Size_CmbBx.SelectedItem = Note_Font_Size_CmbBx.SelectedItem
                External_Note_Font_Style_CmbBx.SelectedItem = Note_Font_Style_CmbBx.SelectedItem
                External_Note_Font_Color_ClrCmbBx.SelectedItem = Note_Font_Color_ClrCmbBx.SelectedItem
                External_Note_Back_Color_ClrCmbBx.SelectedItem = Note_Back_Color_ClrCmbBx.SelectedItem
                External_Note_Alternating_Row_Color_ClrCmbBx.SelectedItem = Alternating_Row_Color_ClrCmbBx.SelectedItem
                For Each Cntrl As Control In FindControlRecursive(New List(Of Control), Me, New List(Of Type))
                    If IgnoreForeBackground(Cntrl) Then
                        Continue For
                    End If
                    Cntrl.ForeColor = External_Note_Font_Color_ClrCmbBx.SelectedItem
                    Cntrl.BackColor = External_Note_Back_Color_ClrCmbBx.SelectedItem
                Next
                Me.WindowState = FormWindowState.Normal
                RefreshInvalidate()
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            ApplicationDoEvents(Me)
            MagNotes_Notes_TabControl_Add_MenuStrip()
            Me.Opacity = 0.9
            Me.Focus()
            SetForegroundWindow(Me.Handle)
        End Try
    End Sub
