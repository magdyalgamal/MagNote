    Public Function LoadShortcutListFiles(ByVal ShortcutsLstVw As ListView, ByVal FilePath As Object, ByVal ShortCutTbPgName As String, Optional AnotherForm As Form = Nothing) As Boolean

        Dim IsFolder
        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Dim ShortcutsToDelete As String = String.Empty
        Try
            Using XMLEditor As New XMLEditor("MagNoteShortcuts.xml", "MagNoteShortcuts")
                Dim ElmntRoot = XMLEditor.Element_Exist("MagNoteShortcuts", New Dictionary(Of String, String) From {{"MagNoteShortcuts", Replace(ShortCutTbPgName, Space(1), "_")}}, , 1)

                Dim iterator As Object = ElmntRoot
                Dim count As Integer
                If TypeOf iterator Is IEnumerable(Of XElement) Then
                    count = DirectCast(iterator, IEnumerable(Of XElement)).Count()
                Else
                    count = 0
                End If

                ShortcutsLstVw.LargeImageList = imageList1
                ShortcutsLstVw.SmallImageList = imageList1
                ShortcutsLstVw.View = View.LargeIcon
                imageList1.ImageSize = New Size(48, 48)
                Dim MyIconSize = IconSize.ExtraLarge
                ShortcutsLstVw.AllowColumnReorder = True
                ShortcutsLstVw.Sorting = SortOrder.Ascending
                ShortcutsLstVw.ShowItemToolTips = True
                imageList1.ColorDepth = ColorDepth.Depth32Bit
                Dim lvi As ListViewItem
                Dim item As ListViewItem
                Dim Extension
                'Dim IsFolder As Boolean
                ShortcutsLstVw.Items.Clear()
                LoadImagesList()
                Dim ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, count, AnotherForm)
                For Each Element In ElmntRoot
                    progress += ProgressToAdd
                    Previewlbl.Text = "Loading--> " & Element.element("Label")?.Value & vbNewLine & Math.Floor(progress * 100)
                    Previewlbl.Refresh()
                    Previewlbl.Invalidate()
                    Try
                        IsFolder = (System.IO.File.GetAttributes(Element.element("Path")?.Value) And System.IO.FileAttributes.Directory) = FileAttributes.Directory
                    Catch ex As Exception
                        IsFolder = False
                        If ShowMsgDialogResult = DialogResult.Cancel Then Continue For
                        If Language_Btn.Text = "ع" Then
                            Msg = "You Can Reload All The Shortcuts Again By Right Clicking On The List... Do You Want To Delete The Shortcut"
                        Else
                            Msg = "يمكنك إعادة تحميل جميع الاختصارات مرة أخرى عن طريق النقر فوق القائمة بزر الماوس الأيمن... هل تريد إلغاء الاختصار؟"
                        End If
                        If ShowMsg(Element.element("Label")?.Value & vbNewLine & vbNewLine & ex.Message & Msg & vbNewLine & Element.element("Path")?.Value, "InfoSysMe (MagNote)", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False) = DialogResult.Cancel Then
                            Continue For
                        ElseIf ShowMsgDialogResult = DialogResult.Yes Then
                            ShortcutsToDelete &= Element.name.ToString & ",Path," & Element.element("Path")?.Value & vbNewLine
                            Continue For
                        End If
                    End Try
                    If IsFolder Then
                        Extension = "Folder"
                    Else
                        Extension = Path.GetFileName(Element.element("Path")?.Value)
                    End If
                    item = New ListViewItem(Path.GetFileName(Element.element("Path")?.Value), 1)
                    If ShortcutsLstVw.Items.Count > 0 Then
                        If Not IsNothing(ShortcutsLstVw.FindItemWithText(item.Text, False, 0, False)) Then Continue For
                    End If
                    If Not (imageList1.Images.ContainsKey(Extension)) Then
                        Dim Img As New PictureBox
                        Using IH As New IconHelper
                            If IsFolder Then
#Disable Warning BC42025 ' Access of shared member, constant member, enum member or nested type through an instance
                                Img.Image = IH.GetIconFrom(Element.element("Path")?.Value, MyIconSize, 0).ToBitmap
#Enable Warning BC42025 ' Access of shared member, constant member, enum member or nested type through an instance
                                imageList1.Images.Add(Extension, Img.Image)
                            Else
#Disable Warning BC42025 ' Access of shared member, constant member, enum member or nested type through an instance
                                Img.Image = IH.GetIconFrom(Element.element("Path")?.Value, MyIconSize, 1).ToBitmap
#Enable Warning BC42025 ' Access of shared member, constant member, enum member or nested type through an instance
                                imageList1.Images.Add(Extension, Img.Image)
                            End If
                        End Using
                    End If
                    item.ImageKey = Extension
                    item.Name = Path.GetFileName(Element.element("Path")?.Value)

                    lvi = ShortcutsLstVw.Items.Add(item)
                    lvi.Text = Element.element("Label")?.Value
                    lvi.Tag = Element.element("Path")?.Value
                    lvi.ToolTipText = Extension
                Next
                ShortcutsLstVw.ListViewItemSorter = New ListViewItemComparer(0)
                ShortcutsLstVw.Sort()
                Load_Shortcuts_ToolTips(ShortcutsLstVw)
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            If ShortcutsToDelete.Length > 0 Then
                Using XMLEditor As New XMLEditor("MagNoteShortcuts.xml", "MagNoteShortcuts")
                    For Each line In ShortcutsToDelete.Split(New String() {vbCrLf, vbLf, vbNewLine}, StringSplitOptions.RemoveEmptyEntries).ToList()
                        XMLEditor.Delete(Split(line, ",").ToList.Item(0), New Dictionary(Of String, String) From {{Split(line, ",").ToList.Item(1), Split(line, ",").ToList.Item(2)}}, 0, 0)
                    Next
                End Using
            End If
            Cursor = Cursors.Default
            Cursor = Cursors.Default
            PreviewPnl.Visible = False
            PreviewPnl.Dispose()
        End Try
    End Function

