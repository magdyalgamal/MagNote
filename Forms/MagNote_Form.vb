    Private Sub GetRecycleBinDateDeleted()
        Dim shell As New Shell()
        Dim recycleBin As Folder = shell.NameSpace(&H10)
        If recycleBin IsNot Nothing Then
            For Each item As FolderItem In recycleBin.Items
                Dim deleteDateStr As String = recycleBin.GetDetailsOf(item, 3)
                If Not String.IsNullOrEmpty(deleteDateStr) Then
                    deleteDateStr = Replace(Replace(deleteDateStr, ChrW(&H200E), ""), ChrW(&H200F), "")
                    deleteDateStr = deleteDateStr.Trim()
                    Dim deleteDate As DateTime
                    If Not DateTime.TryParse(deleteDateStr, deleteDate) Then
                        Dim formats As String() = {"M/d/yyyy h:mm tt", "MM/dd/yyyy h:mm tt", "M/d/yyyy", "MM/dd/yyyy", "yyyy/MM/dd hh:mm tt"}
                        If Not DateTime.TryParseExact(deleteDateStr, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, deleteDate) Then
                            Continue For
                        End If
                    End If
                    If item.Name = "Update(InfoSysMe Corporation)FileInformation.txt" Then
                        If Convert.ToDateTime(Format(deleteDate, "yyyy/MM/dd hh:mm:ss tt")) < Now.AddMonths(-1) Then
                            Dim parentFolderPath As String = item.Path
                            Dim recycleBinSelfPath = recycleBin.Self.Path
                            If parentFolderPath.StartsWith(recycleBin.Self.Path, StringComparison.OrdinalIgnoreCase) Then
                                Try
                                    item.InvokeVerb("Delete")
                                    'File.Delete(item.Name)
                                    'ShowMsg($"Deleted: {item.Name} Deleted File", "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False, 0,,,,,, 0)
                                Catch ex As Exception
                                End Try
                            Else
                                'MessageBox.Show($"Skipped: {item.Name} (Not in Recycle Bin)")
                            End If

                        End If
                    End If
                Else
                    'MessageBox.Show($"File: {item.Name}, Date Deleted: Not available")
                End If
                ApplicationDoEvents(Me)
            Next
        Else
            'MessageBox.Show("Could not access the Recycle Bin.")
        End If
    End Sub
    Private Sub DeleteSpecificFiles()
        Try
            Dim SH As New Shell32.Shell
            Dim RecycleBin As Shell32.Folder = SH.NameSpace(Shell32.ShellSpecialFolderConstants.ssfBITBUCKET)
            Dim itemsToDelete As New List(Of FolderItem)
            For Each Item As Shell32.FolderItem In RecycleBin.Items
                Dim itemName As String = Item.Name
                Dim deleteDateStr As String = RecycleBin.GetDetailsOf(Item, 2)
                deleteDateStr = Replace(Replace(deleteDateStr, ChrW(&H200E), ""), ChrW(&H200F), "")
                deleteDateStr = deleteDateStr.Trim()
                Dim deleteDate As DateTime
                If Not DateTime.TryParse(deleteDateStr, deleteDate) Then
                    Dim formats As String() = {"M/d/yyyy h:mm tt", "MM/dd/yyyy h:mm tt", "M/d/yyyy", "MM/dd/yyyy", "yyyy/MM/dd hh:mm tt"}
                    If Not DateTime.TryParseExact(deleteDateStr, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, deleteDate) Then
