    Public Function ReadFile(ByVal fil As String,
                                               Optional ByVal ReturnMagNoteAray As Boolean = False,
                                               Optional ByVal AddFile As Boolean = False,
                                               Optional ByVal UpdateDGVRow As DataGridViewRow = Nothing,
