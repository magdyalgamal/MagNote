    Private Sub ChangeFormControlsColors(ByVal ColorName As String, ByVal FrClr As Boolean, Optional ByVal AskToAdjust As Boolean = False)
        Try
            If Form_Color_Like_Note_ChkBx.CheckState = CheckState.Unchecked Then
                Exit Sub
            End If
            For Each Cntrl As Control In FindControlRecursive(New List(Of Control), Me, New List(Of Type))
                If IgnoreForeBackground(Cntrl) Then
                    Continue For
                End If
                If Cntrl.GetType = GetType(RichTextBox) Or
                        Cntrl.GetType = GetType(ReoGridControl) Then
                    If Cntrl.Name <> Mail_Body_RchTxtBx.Name Then
                        If Cntrl.Name <> MagNotes_Notes_TbCntrl.SelectedTab.Name & "RchTxtBx" And
                            Cntrl.Name <> MagNotes_Notes_TbCntrl.SelectedTab.Text & "Grid" Then
                            Continue For
                        End If
                    End If
                End If
                Cntrl.ForeColor = Note_Font_Color_ClrCmbBx.SelectedItem
                Cntrl.BackColor = Note_Back_Color_ClrCmbBx.SelectedItem
                If Cntrl.GetType = GetType(DataGridView) And Not FrClr Then
                    CType(Cntrl, DataGridView).BackgroundColor = Note_Back_Color_ClrCmbBx.SelectedItem
                    CType(Cntrl, DataGridView).ColumnHeadersDefaultCellStyle.BackColor = Note_Back_Color_ClrCmbBx.SelectedItem
                    CType(Cntrl, DataGridView).RowHeadersDefaultCellStyle.BackColor = Note_Back_Color_ClrCmbBx.SelectedItem
                    CType(Cntrl, DataGridView).RowsDefaultCellStyle.BackColor = Note_Back_Color_ClrCmbBx.SelectedItem
                End If
                AdjustForeColor(Cntrl, AskToAdjust)
            Next
            If Me.FormBorderStyle = FormBorderStyle.None Then
                Form_Controls_Pnl.BackColor = Me.BackColor
            End If
            AdjustForeColor(MsgBox_SttsStrp.Items("MsgBox_TlStrpSttsLbl"))
            RefreshInvalidate()
            ApplicationDoEvents(Me)
        Finally
            Cursor = Cursors.Default
        End Try
    End Sub

