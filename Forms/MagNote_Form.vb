    Private Sub AdjustControlsRightToLeft(container As Control)
        Dim containerWidth As Integer = container.ClientSize.Width - 1 'Me.ClientSize.Width 
        Try
            If Language_Btn.Text = "ع" Or
                container.Name = MagNotes_TbPg.Name Then
                Exit Sub
            End If
            Dim CntrlLst = FindControlRecursive(New List(Of Control), container, New List(Of Type))
            If CntrlLst.Count = 0 Then Exit Sub
            My_Contacts_List_DGV.RightToLeft = RightToLeft.Yes
            Availabel_Users_DGV.RightToLeft = RightToLeft.Yes
            Available_Alerts_DGV.RightToLeft = RightToLeft.Yes
            Alert_Files_DGV.RightToLeft = RightToLeft.Yes
            Search_Result_DGV.RightToLeft = RightToLeft.Yes
            Wallpaper_Images_DGV.RightToLeft = RightToLeft.Yes
            For Each ctrl As Control In CntrlLst
                Try
                    Dim Nm = ctrl.Name
                    ' Store original dock and anchor values
                    Dim originalDock = ctrl.Dock
                    Dim originalAnchor = ctrl.Anchor
                    ' Temporarily disable dock to allow manual adjustment
                    ctrl.Dock = DockStyle.None
                    ' Mirror horizontal position
                    If originalDock = Dock.None Then
                        If New List(Of Type)({GetType(Panel), GetType(GroupBox)}).Contains(ctrl.Parent.GetType) Then
                            ctrl.Left = ctrl.Parent.ClientSize.Width - ctrl.Left - ctrl.Width
                        Else
                            ctrl.Left = containerWidth - ctrl.Left - ctrl.Width
                        End If
                    End If
ChangeRightToLeft:
                    ' Adjust alignment based on control type
                    If TypeOf ctrl Is TextBox Then
                        If DirectCast(ctrl, TextBox).TextAlign <> HorizontalAlignment.Center Then
                            DirectCast(ctrl, TextBox).TextAlign = HorizontalAlignment.Right
                        End If
                    ElseIf TypeOf ctrl Is Label Then
                        If DirectCast(ctrl, Label).TextAlign <> HorizontalAlignment.Center Then
                            DirectCast(ctrl, Label).TextAlign = ContentAlignment.MiddleRight
                        End If
                    ElseIf TypeOf ctrl Is CheckBox Then
                        With DirectCast(ctrl, CheckBox)
                            .TextAlign = ContentAlignment.MiddleRight
                            .CheckAlign = ContentAlignment.MiddleRight
                        End With
                    ElseIf TypeOf ctrl Is RadioButton Then
                        With DirectCast(ctrl, RadioButton)
                            .TextAlign = ContentAlignment.MiddleRight
                            .CheckAlign = ContentAlignment.MiddleRight
                        End With
                    End If
                    If originalDock <> Dock.None Then
                        If originalDock = Dock.Left Then
                            ctrl.Dock = Dock.Right
                        ElseIf originalDock = Dock.Right Then
                            ctrl.Dock = Dock.Left
                        Else
                            ctrl.Dock = originalDock
                        End If
                    Else
                        If ctrl.Anchor = CType((System.Windows.Forms.AnchorStyles.Top Or System.Windows.Forms.AnchorStyles.Right), System.Windows.Forms.AnchorStyles) Then
                            ctrl.Anchor = CType((System.Windows.Forms.AnchorStyles.Top Or System.Windows.Forms.AnchorStyles.Left), System.Windows.Forms.AnchorStyles)
                        ElseIf ctrl.Anchor = CType((System.Windows.Forms.AnchorStyles.Top Or System.Windows.Forms.AnchorStyles.Left), System.Windows.Forms.AnchorStyles) Then
                            ctrl.Anchor = CType((System.Windows.Forms.AnchorStyles.Top Or System.Windows.Forms.AnchorStyles.Right), System.Windows.Forms.AnchorStyles)
                        End If
                    End If
                Catch ex As Exception
                End Try
            Next
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

