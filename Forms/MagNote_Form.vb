            End If
            If MagNote_Category_CmbBx.Text.Length = 0 Then
                If Language_Btn.Text = "E" Then
                    MagNote_Category_CmbBx.Text = "فئة عامة"
                Else
                    MagNote_Category_CmbBx.Text = "Public Category"
                End If
            End If
            ChangeFormControlsColors(Nothing, Nothing)
        End Try
