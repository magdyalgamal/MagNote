    Dim RefreshMemoryTimr = Microsoft.VisualBasic.DateAndTime.Timer

    Public Function ReturnImageInfo(ByVal ImagePath) As String
        Try
            If Microsoft.VisualBasic.DateAndTime.Timer > RefreshMemoryTimr Then
                RefreshMemoryTimr = Microsoft.VisualBasic.DateAndTime.Timer + 60
                Using FM As New ClearMemory
                    FM.FlushMem()
                End Using
            End If
            Using image As Image = Image.FromFile(ImagePath)
                If String.IsNullOrEmpty(ImagePath) Then
                    Return ",,"
                End If
                If Not File.Exists(ImagePath) Then
                    Return ",,"
                End If
                Dim imageFileInfo As FileInfo = New FileInfo(ImagePath)
                Dim imageSize As Long = imageFileInfo.Length
                Dim width As Integer = image.Width
                Dim height As Integer = image.Height
                Return imageSize & "," & width & "," & height
            End Using
        Catch ex As OutOfMemoryException
            Using FM As New ClearMemory
                FM.FlushMem()
            End Using
        End Try
    End Function
