                    If Not isInDataGridView(Pic.cells("File_Path").value, "File_Path", Wallpaper_Images_DGV, 0,,, 1) Then
                        Wallpaper_Images_DGV.Rows.Add(Pic.cells("File_Path").value, Pic.cells("File_Name").value, Pic.cells("File_Size").value, Pic.cells("Image_Width").value, Pic.cells("Image_Height").value)
