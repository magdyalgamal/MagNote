            ShowWindowsNotification(Msg)
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Open_Note_In_New_Tab_ChkBx.CheckState = OSINT_ChkBx
            Cursor = Cursors.Default
            ActiveControl = Actvcntrl
        End Try
    End Sub
    Public Function AddLoadOpenedTabPages(TbPgFiles) As Boolean
        TbPgFiles = Replace(TbPgFiles, vbCr, "")
        If File.Exists(TbPgFiles) Then
            ApplicationDoEvents(Me)
            If IsInMagNoteCmbBx(TbPgFiles) Then
                Return False
            Else
                If MagNoteFileFormat(TbPgFiles, 1) Then
                    MagNoteFileFormat(TbPgFiles)
                Else
                    SelectFileFormat(TbPgFiles)
                    AddToMagNoteNoCmbBx(TbPgFiles, 1)
                End If
                If Not IsInMagNoteCmbBx(TbPgFiles) Then
                    AddToMagNoteNoCmbBx(TbPgFiles, 0)
                End If
            End If
        End If
    End Function
    Private Function IfOpenedTabPagesChanged() As Boolean
        Cursor = Cursors.WaitCursor
        Try
            Dim CurrentTbPgs, OpenedTbPgs
            For Each OpenedTbPg In Available_MagNotes_DGV.Rows
                If File.Exists(OpenedTbPg.cells("MagNote_Name").value) Then
                    CurrentTbPgs &= OpenedTbPg.cells("MagNote_Name").value
                End If
            Next
            Using XMLEditor As New XMLEditor("NewCategories.xml", "Category_Entries")
                Dim OpenedMaagotes = XMLEditor.doc.<Category_Entries>.Elements().Where(Function(e) CStr(e.<Opened>.FirstOrDefault()) = "1")
                If OpenedMaagotes IsNot Nothing Then
                    For Each Elmnt In OpenedMaagotes
                        OpenedTbPgs &= Elmnt.<Path>.Value
                    Next
                End If
            End Using
            ' Extract and normalize paths
            Dim list1 = ExtractFilePaths(OpenedTbPgs)
            Dim list2 = ExtractFilePaths(CurrentTbPgs)
            ' Sort and compare
            list1.Sort()
            list2.Sort()
            If Not list1.SequenceEqual(list2) Then
                Return True
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function
    Function ExtractFilePaths(ByVal input As String) As List(Of String)
        Dim paths As New List(Of String)
        Dim pattern As String = "[A-Za-z]:\\[^:]+?\.txt" ' Match drive letter to .txt path
        For Each match As Match In Regex.Matches(input, pattern)
            paths.Add(match.Value.ToLower()) ' Normalize casing
        Next
        Return paths
    End Function
    Private Sub LoadExternalFiles()
        Try
            Cursor = Cursors.WaitCursor
            Dim OpenedExternalFiles = MagNoteFolderPath & "\OpenedExternalFiles.txt"
            Dim FilesExist As String
            If File.Exists(OpenedExternalFiles) Then
                For Each ExternalFiles In My.Computer.FileSystem.ReadAllText(OpenedExternalFiles, System.Text.Encoding.UTF8).Split(delimiters, StringSplitOptions.None)
                    ExternalFiles = Replace(ExternalFiles, vbCr, "")
                    If File.Exists(ExternalFiles) Then
                        ApplicationDoEvents(Me)
                        If IsInMagNoteCmbBx(ExternalFiles, 0) Then
                            Continue For
                        Else
                            AddToMagNoteNoCmbBx(ExternalFiles, 0)
                        End If
                        FilesExist &= ExternalFiles & vbNewLine
                    End If
                Next
            End If
            My.Computer.FileSystem.WriteAllText(OpenedExternalFiles, FilesExist, 0, System.Text.Encoding.UTF8)
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Cursor = Cursors.Default
        End Try
    End Sub
