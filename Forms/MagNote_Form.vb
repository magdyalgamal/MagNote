    Dim ForceStopPlayingCurrentPlayedFile As Boolean
    Dim DurationTime As DateTime
    Dim Duration As Double
    Dim TimeSpan As TimeSpan
    Dim MediaFile As IWMPMedia
    Dim PreviousePlayingFile As String
    Private Function GetDuration(ByVal FileName As String, Optional ByVal ReturnDuration As Boolean = False)
        Try
            If String.IsNullOrEmpty(FileName) Then Return False
            If Not File.Exists(FileName) Then Return False
            MediaFile = wmp.newMedia(FileName)
            Duration = MediaFile.duration
            TimeSpan = TimeSpan.FromSeconds(Duration)
            If ReturnDuration Then
                Return Math.Round(TimeSpan.TotalMinutes, 2)
            End If
            DurationTime = Now
            DurationTime = DurationTime.AddMilliseconds(TimeSpan.Milliseconds)
            DurationTime = DurationTime.AddSeconds(TimeSpan.Seconds)
            DurationTime = DurationTime.AddMinutes(TimeSpan.Minutes)
            DurationTime = DurationTime.AddHours(TimeSpan.Hours)
            Return True
        Catch ex As Exception
        End Try
    End Function
    Private Function SpendDuration(ByVal FileName As String, ByVal Alert As DataGridViewRow)
        Try

            If Not GetDuration(FileName) Then Return False
            While wmp.playState = WMPLib.WMPPlayState.wmppsPlaying Or
                   wmp.playState = WMPLib.WMPPlayState.wmppsTransitioning
                ChangPlyCntrlBackColor(0)
                ApplicationDoEvents(Me, 1)
                ChangPlyCntrlBackColor(1)
                If Now >= DurationTime Then
                    Exit While
                End If
            End While
        Finally
            ChangPlyCntrlBackColor(2)
        End Try
    End Function
    Private Function ChangPlyCntrlBackColor(ByVal Back As Integer) As Boolean
        If Back = 0 Then
            Stop_Voice_Azan_File_Btn.BackColor = Color.Red
            Stop_Fagr_Voice_File_Btn.BackColor = Color.Red
            Stop_Playing_Alert_Btn.BackColor = Color.Red
        ElseIf Back = 1 Then
            Stop_Voice_Azan_File_Btn.BackColor = Color.White
            Stop_Fagr_Voice_File_Btn.BackColor = Color.White
            Stop_Playing_Alert_Btn.BackColor = Color.White
        ElseIf Back = 2 Then
            Stop_Voice_Azan_File_Btn.BackColor = Play_Alert_Btn.BackColor 'System.Drawing.SystemColors.Control
            Stop_Fagr_Voice_File_Btn.BackColor = Play_Alert_Btn.BackColor 'System.Drawing.SystemColors.Control
            Stop_Playing_Alert_Btn.BackColor = Play_Alert_Btn.BackColor 'System.Drawing.SystemColors.Control
        End If
        Stop_Voice_Azan_File_Btn.Refresh()
        Stop_Fagr_Voice_File_Btn.Refresh()
        Stop_Playing_Alert_Btn.Refresh()
    End Function
    Dim synth As New SpeechSynthesizer()
    Private Function PlayAlertName(ByVal TextToRead) As Boolean
        ' Create an instance of SpeechSynthesizer
        synth = New SpeechSynthesizer()

        '' List all installed voices to find Arabic voices
        'For Each voice In synth.GetInstalledVoices()
        '    Console.WriteLine(voice.VoiceInfo.Name & " - " & voice.VoiceInfo.Culture.ToString())
        'Next

        ' Select the Arabic voice (if installed)
        ' Make sure to use the exact name of the Arabic voice installed on your system
        Try
            If ContainsArabic(TextToRead) Then
                synth.SelectVoice("Microsoft Hoda") ' Example: Arabic voice
            Else
                synth.SelectVoice("Microsoft David Desktop") ' Example: Arabic voice
            End If
        Catch ex As Exception
            Console.WriteLine("Arabic voice not found: " & ex.Message)
            Return False
        End Try

        ' Set the volume and rate (optional)
        synth.Volume = 100
        synth.Rate = 0

        ' Read Arabic text aloud
        synth.SpeakAsync(TextToRead)

        ' Optionally dispose of the synthesizer object when done
        'synth.Dispose()
    End Function
    Function ContainsArabic(input As String) As Boolean
        Dim arabicPattern As String = "[\u0600-\u06FF\u0750-\u077F]"
        Return Regex.IsMatch(input, arabicPattern)
    End Function
    Dim wmppsTransitioningTime
    Private Sub Play_Alert_Btn_Click(sender As Object, e As EventArgs, Optional ByVal Alert As DataGridViewRow = Nothing) Handles Play_Alert_Btn.Click
        Try
            If Mute_ChkBx.CheckState = CheckState.Checked Then
                Exit Sub
            End If
            If Not IsNothing(Alert) Then
                If Alert.Index = -1 Then
                    Exit Sub
                End If
                Dim TimeForLoop = Now
                If Val(Alert.Cells("Play_Alert_Comment").Value.ToString) = 1 Then
                    For x = 1 To 5
                        While TimeForLoop > Now
                            ApplicationDoEvents(Me, 1)
                        End While
                        PlayAlertName(Alert.Cells("Alert_Comment").Value)
                        While synth.State = SynthesizerState.Speaking
                            ApplicationDoEvents(Me, 1)
                        End While
                        TimeForLoop = Now.AddSeconds(10)
                    Next
                    'GoTo PlayAlertCommentFinished
                End If
            End If

            If Alert_Voice_Path_TxtBx.TextLength = 0 Then Exit Sub
            MediaFile = wmp.newMedia(Alert_Voice_Path_TxtBx.Text)
            wmp.currentMedia = MediaFile
            wmp.controls.play()
            'PlayAlertCommentFinished:
            If Not IsNothing(Alert) Then
                Available_Alerts_DGV.Rows(Alert.Index).Cells("Last_Played_File").Value = Alert_Voice_Path_TxtBx.Text
                Setting_TbCntrl.Refresh()
            End If
            GetDuration(Alert_Voice_Path_TxtBx.Text)
            If wmp.playState = WMPLib.WMPPlayState.wmppsTransitioning Then
                wmppsTransitioningTime = Convert.ToDateTime(Now.AddSeconds(5))
            Else
                wmppsTransitioningTime = Nothing
            End If
            While wmp.playState = WMPLib.WMPPlayState.wmppsTransitioning Or
                Now >= DurationTime
                ChangPlyCntrlBackColor(0)
                ApplicationDoEvents(Me, 1)
                ChangPlyCntrlBackColor(1)
                If IsDate(wmppsTransitioningTime) Then
                    If Now > Convert.ToDateTime(wmppsTransitioningTime) Then
                        wmp.controls.stop()
                        Exit While
                    End If
                End If
            End While
            Try
                SpendDuration(Alert_Voice_Path_TxtBx.Text, Alert)
            Finally
            End Try
            If IsNothing(Alert) Then Exit Sub
            If Not String.IsNullOrEmpty(Alert.Cells("Alert_Sound_Volume").Value) Then
                If GetVolume() = CurentAlertSoundVolume Then
                    SetVolume(CurentSoundVolume)
                End If
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & vbNewLine & "Voice File=(" & Alert_Voice_Path_TxtBx.Text & ")" & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            PlayAlert = False
            PreviousePlayingFile = Alert_Voice_Path_TxtBx.Text
            ChangPlyCntrlBackColor(2)
        End Try
    End Sub

    Private Sub Add_Alert_Flder_Files_Btn_Click(sender As Object, e As EventArgs) Handles Add_Alert_Flder_Files_Btn.Click
        Using folderDialog As New FolderBrowserDialog
            AddAlertFilesDGVColumn()
            folderDialog.Description = "Select Alert Voice Folder Path"
            If File.Exists(Alert_Voice_Path_TxtBx.Text) Then
                folderDialog.SelectedPath = Path.GetDirectoryName(Alert_Voice_Path_TxtBx.Text) 'Environment.SpecialFolder.MyComputer
            Else
                folderDialog.SelectedPath = ApplicationStartupPath
            End If
            If folderDialog.ShowDialog() = DialogResult.OK Then
                If Alert_Files_DGV.Rows.Count > 0 And
                    Alert_Files_DGV.Rows.Count > 0 Then
                    If Language_Btn.Text = "E" Then
                        Msg = "هل تريد اضافة الملفات المختارة الى الملفات المضافة سابقا؟"
                    Else
                        Msg = "Do You Want To Add Selected Files To Previously Added Files?"
                    End If
                    If ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False) = DialogResult.No Then
                        Alert_Files_DGV.Rows.Clear()
                    End If
                End If
                Alert_Voice_Path_TxtBx.Text = folderDialog.SelectedPath
                Alert_Voice_Files_CmbBx.Items.Clear()
                DoRecursiveSearch(Alert_Voice_Path_TxtBx.Text,,, 1)
                For Each File In Alert_Voice_Files_CmbBx.Items
                    Alert_Files_DGV.Rows.Add(DirectCast(File, KeyValuePair(Of String, String)).Key, Path.GetFileName(DirectCast(File, KeyValuePair(Of String, String)).Key), GetDuration(DirectCast(File, KeyValuePair(Of String, String)).Key, 1))
                Next
            End If
        End Using
