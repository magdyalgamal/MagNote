    Private Function ReturnNewFileName(Optional ByVal NewFileName As String = Nothing) As String
        NewFileName = MagNoteFolderPath & "\MagNote -(" & FileCount & ")-." & DirectCast(File_Format_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key

        If IsInMagNoteCmbBx(MagNoteFolderPath & "\MagNote -(" & FileCount & ")-." & DirectCast(File_Format_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key, 0) Then
            FileCount += 1
            ReturnNewFileName()
            GoTo FinallFunction
        End If
        If File.Exists(NewFileName) Then
            FileCount += 1
            ReturnNewFileName()
            GoTo FinallFunction
        End If

        If IsInMagNoteCmbBx(MagNoteFolderPath & "\MagNote -(" & FileCount & ")-." & DirectCast(File_Format_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key, 0) Or
                    File.Exists(NewFileName) Then
            ReturnNewFileName()
            GoTo FinallFunction
        End If
        'Debug.Print(FileCount)
FinallFunction:
        Return MagNoteFolderPath & "\MagNote -(" & FileCount & ")-." & DirectCast(File_Format_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key
    End Function
    Private Function Correct_MagNote_TxtBx_Font_Color(Optional ByVal ReturnDarkOrLight As Boolean = False)
        Dim brightness As Single = Note_Back_Color_ClrCmbBx.BackColor.GetBrightness
