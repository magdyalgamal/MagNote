    Private Sub Alert_Tmr_Tick(sender As Object, e As EventArgs) Handles Alert_Tmr.Tick
        Try
            If Force_Stop_Playing_Current_Sound_File_ChkBx.CheckState = CheckState.Unchecked And
                wmp.playState = WMPLib.WMPPlayState.wmppsPlaying Then
                Exit Sub
            End If
            If (Debugger.IsAttached And Stop_Alert_Where_Debugger_Is_Attached_ChkBx.CheckState = CheckState.Checked) Then
                Alert_Tmr.Stop()
                Me.ActiveControl = Enable_Update_Btn
                Enable_Update_Btn_Click(Enable_Update_Btn, EventArgs.Empty)
                Exit Sub
            End If
            If Activate_Alert_Function_ChkBx.CheckState = CheckState.Unchecked Then
                Alert_Tmr.Stop()
                If Alert_Setting_Pnl.Enabled Then
                    Me.ActiveControl = Enable_Update_Btn
                    Enable_Update_Btn_Click(Enable_Update_Btn, EventArgs.Empty)
                End If
                Exit Sub
            End If
            For Each Alert In Available_Alerts_DGV.Rows
                'If Alert.cells("Alert_Comment").value = "آيات قرآنية متفرقة" Then
                '    Dim x = 1
                'End If
                If Not Convert.ToBoolean(Val(Alert.Cells("Alert_Active").Value)) Then
                    Continue For
                End If
                NextAlertTime = Convert.ToDateTime(Alert.Cells("Next_Alert_Time").Value)
                NowAlertTime = Convert.ToDateTime(Now)
                EndAlertTime = Convert.ToDateTime(Alert.Cells("End_Alert_Time").Value)
                InfinityAlert = Convert.ToBoolean(Val(Alert.Cells("Infinity_Alert").Value))
                If NextAlertTime > EndAlertTime And
                    Not InfinityAlert And
                    Val(Alert.cells("Alert_Type").Value) = 0 Then
                    Available_Alerts_DGV.Rows(Alert.index).Cells("Alert_Active").Value = 0
                    SaveDataGridViewToXml()
                    Continue For
                End If
                If NowAlertTime >= NextAlertTime Then
                    If wmp.playState = WMPLib.WMPPlayState.wmppsPlaying Then
                        If ForceStopPlayingCurrentFile Then
                            Continue For
                        End If
                    End If
                    Alert_Voice_Files_CmbBx.Items.Clear()
                    For Each file In Alert.Cells("Sound_Files_To_Play").Value.ToString.Split(delimiters, StringSplitOptions.None)
                        Alert_Voice_Files_CmbBx.Items.Add(New KeyValuePair(Of String, String)(file, Path.GetFileNameWithoutExtension(file)))
                    Next
                    IsInMagNoteCmbBx(Alert.Cells("Last_Played_File").Value, 1, Alert_Voice_Files_CmbBx)
                    Dim TimeToUpdate As DateTime
                    Dim CheckTime As DateTime = Now
                    If InfinityAlert Then
                        CheckTime = CheckTime.AddMinutes(-Val(Alert.Cells("Alert_Repeet_Minute").Value))
                        CheckTime = CheckTime.AddHours(-Val(Alert.Cells("Alert_Repeet_Hour").Value))
                        CheckTime = CheckTime.AddDays(-Val(Alert.Cells("Alert_Repeet_Day").Value))
                        TimeToUpdate = NextAlertTime
                    Else
                        CheckTime = CheckTime.AddMinutes(-Val(Alert.Cells("Minutes_Between_Repetitions").Value))
                        CheckTime = CheckTime.AddHours(-Val(Alert.Cells("Hours_Between_Repetitions").Value))
                        CheckTime = CheckTime.AddDays(-Val(Alert.Cells("Days_Between_Repetitions").Value))
                        TimeToUpdate = NextAlertTime
                    End If
                    CurrentTime = TimeToUpdate
                    If InfinityAlert Then
                        RepeetValue = Val(Alert.Cells("Alert_Repeet_Minute").Value.ToString) +
                                        Val(Alert.Cells("Alert_Repeet_Hour").Value.ToString) +
                                        Val(Alert.Cells("Alert_Repeet_Day").Value.ToString)
                    Else
                        RepeetValue = Val(Alert.Cells("Minutes_Between_Repetitions").Value.ToString) +
                                        Val(Alert.Cells("Hours_Between_Repetitions").Value.ToString) +
                                        Val(Alert.Cells("Days_Between_Repetitions").Value.ToString)
                    End If
                    If RepeetValue <> 0 Then
                        While TimeToUpdate < CheckTime
                            If InfinityAlert Then
                                TimeToUpdate = TimeToUpdate.AddMinutes(Val(Alert.Cells("Alert_Repeet_Minute").Value))
                                TimeToUpdate = TimeToUpdate.AddHours(Val(Alert.Cells("Alert_Repeet_Hour").Value))
                                TimeToUpdate = TimeToUpdate.AddDays(Val(Alert.Cells("Alert_Repeet_Day").Value))
                            Else
                                TimeToUpdate = TimeToUpdate.AddMinutes(Val(Alert.Cells("Minutes_Between_Repetitions").Value))
                                TimeToUpdate = TimeToUpdate.AddHours(Val(Alert.Cells("Hours_Between_Repetitions").Value))
                                TimeToUpdate = TimeToUpdate.AddDays(Val(Alert.Cells("Days_Between_Repetitions").Value))
                            End If
                        End While
                    End If
                    If (InfinityAlert And
                        Val(Alert.cells("Alert_Type").Value) = 0) Or
                        RepeetValue = 0 Then
                        TimeToUpdate = TimeToUpdate.AddMinutes(Val(Alert.Cells("Alert_Repeet_Minute").Value))
                        TimeToUpdate = TimeToUpdate.AddHours(Val(Alert.Cells("Alert_Repeet_Hour").Value))
                        TimeToUpdate = TimeToUpdate.AddDays(Val(Alert.Cells("Alert_Repeet_Day").Value))
                    Else
                        TimeToUpdate = TimeToUpdate.AddMinutes(Val(Alert.Cells("Minutes_Between_Repetitions").Value))
                        TimeToUpdate = TimeToUpdate.AddHours(Val(Alert.Cells("Hours_Between_Repetitions").Value))
                        TimeToUpdate = TimeToUpdate.AddDays(Val(Alert.Cells("Days_Between_Repetitions").Value))
                    End If

                    If Val(Alert.cells("Alert_Type").Value) <> 0 Then
                        Dim TOD1 = Now.TimeOfDay
                        Dim TOD2 = CType(Alert.cells("Start_Alert_Time").Value, DateTime).TimeOfDay
                        Dim TOD3 = CType(Alert.cells("End_Alert_Time").Value, DateTime).TimeOfDay
                        Select Case Val(Alert.cells("Alert_Type").Value)
                            Case 1 'Weekly
                                If Alert.cells("Week_Day").Value <> Array.IndexOf(EnglishWeekDay, TimeToUpdate.ToString("dddd")) Then
                                    Continue For
                                End If
                                If Now.TimeOfDay > CType(Alert.cells("End_Alert_Time").Value, DateTime).TimeOfDay Then
                                    Dim dNext = Alert.Cells("Next_Alert_Time").Value
                                    Dim dStart = Alert.Cells("Start_Alert_Time").Value
                                    Dim dEnd = Alert.Cells("End_Alert_Time").Value

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("Start_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("Start_Alert_Time").Value).AddDays(14)

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("Next_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("Start_Alert_Time").Value)

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("End_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("End_Alert_Time").Value).AddDays(14)

                                    Dim dNexta = Available_Alerts_DGV.Rows(Alert.index).Cells("Next_Alert_Time").Value
                                    Dim dStarta = Available_Alerts_DGV.Rows(Alert.index).Cells("Start_Alert_Time").Value
                                    Dim dEnda = Available_Alerts_DGV.Rows(Alert.index).Cells("End_Alert_Time").Value
                                    Continue For
                                End If
                            Case 2 'Monthly
                                If Convert.ToDateTime(Alert.Cells("Next_Alert_Time").Value).Day <> TimeToUpdate.Day Then
                                    Continue For
                                End If

                                If Now.TimeOfDay > CType(Alert.cells("End_Alert_Time").Value, DateTime).TimeOfDay Then

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("Start_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("Start_Alert_Time").Value).AddMonths(2)

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("Next_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("Start_Alert_Time").Value)

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("End_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("End_Alert_Time").Value).AddMonths(2)

                                    Continue For
                                End If
                            Case 3 'Yearly
                                If Convert.ToDateTime(Alert.Cells("Next_Alert_Time").Value).Day <> TimeToUpdate.Day Or
                                    Convert.ToDateTime(Available_Alerts_DGV.Rows(Alert.index).Cells("Next_Alert_Time").Value).Month <> TimeToUpdate.Month Then
                                    Continue For
                                End If
                                If Now.TimeOfDay > CType(Alert.cells("End_Alert_Time").Value, DateTime).TimeOfDay Then

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("Start_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("Start_Alert_Time").Value).AddYears(2)

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("Next_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("Start_Alert_Time").Value)

                                    Available_Alerts_DGV.Rows(Alert.index).Cells("End_Alert_Time").Value = Convert.ToDateTime(Alert.Cells("End_Alert_Time").Value).AddYears(2)

                                    Continue For
                                End If
                        End Select
                        If Not (Now.TimeOfDay >= CType(Alert.cells("Start_Alert_Time").Value, DateTime).TimeOfDay AndAlso Now.TimeOfDay <= CType(Alert.cells("End_Alert_Time").Value, DateTime).TimeOfDay) Then
                            Continue For
                        End If
                    End If
                    Available_Alerts_DGV.Rows(Alert.index).Cells("Next_Alert_Time").Value = TimeToUpdate
                    If Convert.ToBoolean(Val(Alert.Cells("Related_To_MagNote").Value.ToString)) Then
                        AlertRelatedToMagNote(Alert)
                    End If
                    If Not String.IsNullOrEmpty(Alert.Cells("Alert_Sound_Volume").Value) Then
                        CurentSoundVolume = GetVolume()
                        CurentAlertSoundVolume = Alert.Cells("Alert_Sound_Volume").Value
                        SetVolume(CurentAlertSoundVolume)
                    End If
                    If Convert.ToBoolean(Val(Alert.Cells("Force_Stop_Playing_Current_File").Value.ToString)) And
                        wmp.playState = WMPLib.WMPPlayState.wmppsPlaying Then
                        wmp.controls.stop()
                        wmp.close()
                    End If
                    If Not Convert.ToBoolean(Val(Alert.Cells("Force_Stop_Playing_Current_File").Value.ToString)) Then
                        Alert_Tmr.Start()
                    End If
                    If Convert.ToBoolean(Val(Alert.Cells("Force_Activate_MagNote_When_Alert_Is_Active").Value.ToString)) Then
                        Me.Activate()
                        Me.WindowState = FormWindowState.Maximized
                        Me.BringToFront()
                    End If
                    If CType(Alert, DataGridViewRow).Index <> -1 Then
                        AlertExist = True
                        PlayAlertFile(Alert, CurrentTime)
                    Else
                        Dim xx = 1
                    End If
                End If
            Next
            If AlertExist Then
                SaveDataGridViewToXml()
            End If
            AlertExist = False
            For Each Alert In Available_Alerts_DGV.Rows
                If Not Convert.ToBoolean(Val(Alert.Cells("Alert_Active").Value)) Then
                    Continue For
                End If
                AlertExist = True
                Exit For
            Next
            If Not AlertExist And Available_Alerts_DGV.Rows.Count > 0 Then
                Enable_Update_Btn_Click(Enable_Update_Btn, EventArgs.Empty)
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & Alert_Comment_TxtBx.Text, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            NextAlertTime = Nothing
            NowAlertTime = Nothing
            EndAlertTime = Nothing
            InfinityAlert = Nothing
            AlertExist = False
            ValidRepetition = False
            RepeetValue = Nothing
            CurrentTime = Nothing
            If Alert_Setting_Pnl.Enabled = False Then
                Alert_Tmr.Start()
            End If
        End Try
    End Sub

    Private Sub LoadAlertsIntoGrid(xmlPath As String, dgv As DataGridView)
        Try
            ' Load the XML document
            Dim doc As XDocument = XDocument.Load(xmlPath)
            dgv.Rows.Clear()
            Alert_Files_DGV.Rows.Clear()
            Dim alerts = doc.Root.Elements()
            ' Auto-detect all column names from the first alert
            Dim allFields = alerts.SelectMany(Function(a) a.Elements()).Select(Function(e) e.Name.LocalName).Distinct()
            ' Add rows for each alert
            Dim Column As New DataGridViewTextBoxCell()
            For Each alert In alerts
                Dim row As New DataGridViewRow
                For Each field In allFields
                    Dim value As String
                    ' Handle nested <Sound_Files_To_Play> specially
                    If field = "Sound_Files_To_Play" Then
                        Dim soundFiles = alert.Element(field)
                        If soundFiles IsNot Nothing Then
                            value = String.Join(vbNewLine, soundFiles.Elements("File_Name").Select(Function(f) f.Value))
                        Else
                            value = ""
                        End If
                    Else
                        value = alert.Element(field)?.Value
                    End If
