    Private Sub MagNote_Form_FormClosing(sender As Object, e As FormClosingEventArgs) Handles Me.FormClosing
        Try
            'Debugger.Launch()
            If e.CloseReason = CloseReason.UserClosing And
                Not systemShutdown Then
                e.Cancel = True
                If RunAsExternal() Then
                    SaveExternalParameters()
                    Dim DR As DialogResult = NoteAmendmented()
                    If DR = DialogResult.No Or
                        DR = DialogResult.Cancel Then
                        Exit Sub
                    Else
                        e.Cancel = False
                    End If
                End If
                If Not RunAsExternal() And
                    Not AlreadyAsked And
                    Minimize_After_Running_My_Shortcut_ChkBx.CheckState <> CheckState.Indeterminate And
                    Not ApplicationRestart Then
                    AlreadyAsked = True
                    If Language_Btn.Text = "ع" Then
                        Msg = "MagNote Will Be Always In Windows System Tray And Ready To Call By Clicking (Alt+s) Until You Exit The Note From The Windows System Tray!!!"
                    Else
                        Msg = "تذكر دائما أن برنامج الماجنوت سيكون مخفيا فى علبة الايقونات المخفية للنوافذ ويمكن استدعائة بالنقر على" & vbNewLine & " ـ(Alt+s)ـ " & vbNewLine & "... حتى يتم الخروج من البرنامج"
                    End If
                    ShowWindowsNotification(Msg, 1)
                End If
                If Secured_Note_ChkBx.CheckState = CheckState.Checked Then
                    MagNote_No_CmbBx.SelectedIndex = -1
                    RCSN.Text = String.Empty
                End If
                Me.WindowState = FormWindowState.Minimized
                Exit Sub
            End If
            CurrentMagNoteName = SetCurrentMagNoteName()
            SaveDataGridViewToXml(0)
            RemoveHandler SystemEvents.SessionEnding, AddressOf OnSessionEnding
            RemoveHandler SystemEvents.SessionSwitch, AddressOf OnSessionSwitch
            If Save_Status_History_On_Exit_ChkBx.CheckState = CheckState.Checked Then
                SaveStatusHistory()
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Cursor = Cursors.Default
        End Try
    End Sub
    Private Sub SaveStatusHistory()
        Try
            Dim NSNFC = 0
            Dim files() As String = Directory.GetFiles(MagNoteFolderPath, "StatusHistory -(*)-.xml")
            NSNFC = files.Count
            Dim CurrentFile = MagNoteFolderPath & "\StatusHistory -(" & NSNFC & ")-.xml"
            If File.Exists(CurrentFile) Then
                NSNFC = 0
            End If
            While File.Exists(CurrentFile)
                NSNFC += 1
                CurrentFile = MagNoteFolderPath & "\StatusHistory -(" & NSNFC & ")-.xml"
            End While
            Dim xmlRoot As New XElement("StatusHistoryMessages")
            For Each Msg As ToolStripItem In CType(MsgBox_SttsStrp.Items(1), ToolStripDropDownButton).DropDownItems
                Dim statusMessage As New XElement("StatusMessage")
                Dim messageLines = Msg.Text.Split({vbCrLf, vbLf, vbCr}, StringSplitOptions.RemoveEmptyEntries)
                For Each line In messageLines
                    statusMessage.Add(New XElement("MsgLine", line.Trim()))
                Next
                xmlRoot.Add(statusMessage)
            Next

            Using XMLEditor As New XMLEditor(CurrentFile, "StatusHistoryMessages", 0)
                Dim doc As New XDocument(xmlRoot)
                XMLEditor.doc = doc
                XMLEditor.SaveDoc(CurrentFile)
            End Using

            'Dim doc As New XDocument(xmlRoot)
            'doc.Save(CurrentFile)
            If Keep_Last_Week_Only_Of_Saved_Status_Message_ChkBx.CheckState = CheckState.Checked Then
                MoveOldFilesToRecycleBin(MagNoteFolderPath, "StatusHistory -(*)-.xml")
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

    Sub MoveOldFilesToRecycleBin(folderPath As String, fileNamePattern As String)
        Dim dirInfo As New IO.DirectoryInfo(folderPath)
        Dim oneWeekAgo As DateTime = DateTime.Now.AddDays(-7)
        ' Get all matching files
        For Each file In dirInfo.GetFiles(fileNamePattern)
            If file.LastWriteTime < oneWeekAgo Then
                ' Move to Recycle Bin
                FileSystem.DeleteFile(file.FullName,
                                  UIOption.OnlyErrorDialogs,
                                  RecycleOption.SendToRecycleBin)
            End If
        Next
    End Sub

