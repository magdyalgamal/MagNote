    Public Function DoRecursiveSearch(ByVal DirPath As String,
                                      Optional ByVal FileSearchPattern As String = "*.*",
                                      Optional ByVal FolderSearchPattern As String = "*",
                                      Optional ByVal Recursive As Boolean = True,
                                      Optional ByVal CmbBx As ComboBox = Nothing,
                                      Optional ByVal ReturnFullName As Boolean = False) As ArrayList
        Try
            'Debugger.Launch()
            ' Specify the directories you want to manipulate.
            If IsNothing(CmbBx) Then
                CmbBx = Alert_Voice_Files_CmbBx
            End If
            Dim di As System.IO.DirectoryInfo = New System.IO.DirectoryInfo(DirPath)
            Dim ar As New ArrayList
            Try
                ' Get only subdirectories
                Dim dirs As System.IO.FileSystemInfo() = di.GetDirectories(FolderSearchPattern)
                Dim files As System.IO.FileSystemInfo()
                Dim diNext As System.IO.DirectoryInfo
                Dim fiNext As System.IO.FileInfo

                'Dim directoryInfo As New DirectoryInfo(DirPath)
                'Dim allFiles As List(Of FileInfo) = GetAllFiles(directoryInfo)
                Try
                    files = di.GetFiles(FileSearchPattern)
                Catch e As Exception
                    Console.WriteLine("The process failed: {0}", e.ToString())
                End Try
                For Each fiNext In files
                    Try
                        If ReturnFullName Then
                            ar.Add(fiNext.FullName)
                        Else
                            ar.Add(fiNext)
                        End If
                        CmbBx.Items.Add(New KeyValuePair(Of String, String)(fiNext.FullName, Path.GetFileNameWithoutExtension(fiNext.FullName)))
                    Catch e As Exception
                        Console.WriteLine("The process failed: {0}", e.ToString())
                    End Try
                Next

                If Recursive Then
                    For Each diNext In dirs
                        Try
                            ar.AddRange(DoRecursiveSearch(diNext.FullName, FileSearchPattern, FolderSearchPattern, Recursive, CmbBx, ReturnFullName))
                            'Debug.Print(diNext.FullName)
                        Catch e As Exception
                            Console.WriteLine("The process failed: {0}", e.ToString())
                        End Try
                    Next
                End If
                Return ar
            Catch e As Exception
                ShowMsg(e.Message & vbNewLine & "First Exception" & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
            End Try

        Catch ex As Exception
            ShowMsg(ex.Message & vbNewLine & "Second Exception" & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function

    ' Function to get all files including hidden and system files recursively
    Private Function GetAllFiles(dirInfo As DirectoryInfo) As List(Of FileInfo)
        Dim files As New List(Of FileInfo)

        Try
            ' Get all files in the current directory
            files.AddRange(dirInfo.GetFiles("*.*", System.IO.SearchOption.AllDirectories).Where(Function(f) (f.Attributes And FileAttributes.Hidden) = FileAttributes.Hidden OrElse (f.Attributes And FileAttributes.System) = FileAttributes.System OrElse (f.Attributes And FileAttributes.Normal) = FileAttributes.Normal).ToArray())

            ' Recursively get files from subdirectories
            For Each subDir As DirectoryInfo In dirInfo.GetDirectories("*", System.IO.SearchOption.TopDirectoryOnly)
                ' Check for hidden or system subdirectories
                If (subDir.Attributes And FileAttributes.Hidden) = FileAttributes.Hidden OrElse
                   (subDir.Attributes And FileAttributes.System) = FileAttributes.System OrElse
                   (subDir.Attributes And FileAttributes.Normal) = FileAttributes.Normal Then
                    files.AddRange(GetAllFiles(subDir))
                End If
            Next
        Catch ex As UnauthorizedAccessException
            ' Handle any exceptions due to access restrictions
            MessageBox.Show("Access denied to " & dirInfo.FullName)
        End Try

        Return files
    End Function

