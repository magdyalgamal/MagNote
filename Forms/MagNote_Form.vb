    ' Define message for EM_FORMATRANGE
    Private Const WM_USER As Integer = &H400
    Private Const EM_FORMATRANGE As Integer = WM_USER + 57
    Private Const EM_SETTARGETDEVICE As Integer = WM_USER + 72

