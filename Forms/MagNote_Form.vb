    Public Sub LoadGreenAPICmbBx()
        Try
            Green_API_Name_CmbBx.Items.Clear()
            Using XMLEditor As New XMLEditor("GreenAPI.xml", "GreenAPI_Entries")
                Dim docRoot = XMLEditor.Element_Exist("GreenAPI", Nothing,, 1)
                For Each entry In docRoot
                    Dim GreenAPI_Name = entry.Element("GreenAPI_Name")?.Value
                    Dim ID_Instance = entry.Element("ID_Instance")?.Value
                    Green_API_Name_CmbBx.Items.Add(New KeyValuePair(Of String, String)(GreenAPI_Name, ID_Instance))
                Next
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

    Private Sub Update_Category_Btn_Click(sender As Object, e As EventArgs) Handles Update_Category_Btn.Click
        Try
            If MagNotes_Notes_TbCntrl.SelectedTab IsNot Nothing Then
                If SaveNoteCategory(MagNotes_Notes_TbCntrl.SelectedTab.Name,, 1) Then
                    Dim CurrentCategory = MagNote_Category_CmbBx.Text
                    DGVRow = isInDataGridView(MagNotes_Notes_TbCntrl.SelectedTab.Name, "MagNote_Name", Available_MagNotes_DGV, 0, 1)
                    LoadCategories()
                    MagNote_Category_CmbBx.Text = CurrentCategory
                    If DGVRow IsNot Nothing Then
                        Available_MagNotes_DGV.Rows(DGVRow.index).Cells("MagNote_Category").Value = MagNote_Category_CmbBx.Text
                    End If
                    If Language_Btn.Text = "E" Then
                        Msg = "تم تحديث بيانات الفئة الحالية بنجاح"
                    Else
                        Msg = "This Category Have Been Updated Successfully"
                    End If
                    ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.
                            Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
                End If
            Else
                ShowMsg("Kindly Select MagNote First To save The Category", "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
            End If
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

    Private Sub Delete_Category_Btn_Click(sender As Object, e As EventArgs) Handles Delete_Category_Btn.Click
        Try
            Using XMLEditor As New XMLEditor("NewCategories.xml", "Category_Entries")
                XMLEditor.Delete("Category_Entries", New Dictionary(Of String, String) From {{DirectCast(MagNote_Category_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key, Nothing}}, 1)
                LoadCategories()
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub
    Dim MyContactsListDGVBackColor As Color
    Dim MyContactsListDGVForeColor As Color

    Private Sub My_Contacts_List_DGV_CellMouseDown(sender As Object, e As DataGridViewCellMouseEventArgs) Handles My_Contacts_List_DGV.CellMouseDown
        Try
            If My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.BackColor = Color.Green Then
                If My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactType").Value = "Group" Then
                    Phone_Nmber_TxtBx.Text = Phone_Nmber_TxtBx.Text.Replace(My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactId").Value & "@g.us", "")
                Else
                    Phone_Nmber_TxtBx.Text = Phone_Nmber_TxtBx.Text.Replace(My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactId").Value & "@c.us", "")
                End If
                My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.BackColor = MyContactsListDGVBackColor
                My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.ForeColor = MyContactsListDGVForeColor
            Else
                If Phone_Nmber_TxtBx.Text.Contains(My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactId").Value) Then Exit Sub
                If My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactType").Value = "Group" Then
                    Phone_Nmber_TxtBx.Text &= "," & My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactId").Value & "@g.us"
                Else
                    Phone_Nmber_TxtBx.Text &= "," & My_Contacts_List_DGV.Rows(e.RowIndex).Cells("ContactId").Value & "@c.us"
                End If
                MyContactsListDGVBackColor = My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.BackColor
                MyContactsListDGVForeColor = My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.ForeColor
                My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.BackColor = Color.Green
                My_Contacts_List_DGV.Rows(e.RowIndex).DefaultCellStyle.ForeColor = Color.White
            End If
            Phone_Nmber_TxtBx.Text = Replace(Phone_Nmber_TxtBx.Text, ",,", ",")
            If Phone_Nmber_TxtBx.Text.StartsWith(",") Then
                Phone_Nmber_TxtBx.Text = Microsoft.VisualBasic.Right(Phone_Nmber_TxtBx.Text, Phone_Nmber_TxtBx.TextLength - 1)
            End If
            If Phone_Nmber_TxtBx.Text.EndsWith(",") Then
                Phone_Nmber_TxtBx.Text = Microsoft.VisualBasic.Left(Phone_Nmber_TxtBx.Text, Phone_Nmber_TxtBx.TextLength - 1)
            End If
        Catch ex As Exception
        End Try
    End Sub
    Private Sub LoadMagNote_Groups()
        Try
            Group_Name_CmbBx.Items.Clear()
            Using XMLEditor As New XMLEditor("MagNoteGroupsForWhatsApp.xml", "MagNoteGroups")
                Dim docRoot = XMLEditor.Element_Exist("MagNoteGroups", Nothing,, 1)
                For Each entry In docRoot
                    Dim foundByKey = Group_Name_CmbBx.Items.OfType(Of KeyValuePair(Of String, String))().FirstOrDefault(Function(x) x.Key = entry.name.ToString)
                    If IsNothing(foundByKey.Key) Then
                        Group_Name_CmbBx.Items.Add(New KeyValuePair(Of String, String)(entry.name.ToString, Replace(entry.name.ToString, "_", " ")))
                    End If
                Next
