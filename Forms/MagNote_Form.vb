    Private Function ReCreatCategoriesXML()
        Using XMLEditor As New XMLEditor("NewCategories.xml", "Category_Entries")
            Dim CategoryiesFileName = MagNoteFolderPath & "\Categories.xml"
            Dim xmlDoc As New XmlDocument
            xmlDoc.Load(CategoryiesFileName)
            For Each chld In xmlDoc
                Dim x = chld.name
                For Each cat In chld
                    Dim x1 = cat.name
                    For Each ct In cat
                        Dim Nm = ct.Attributes("Name").Value
                        Dim Lbl = String.Empty
                        If Not IsNothing(ct.Attributes("Lable")) Then
                            Lbl = ct.Attributes("Lable").Value.ToString
                        End If
                        Dim Pth = ct.Attributes("Path").Value
                        Dim CrtnDt = ct.Attributes("Creation_Date").Value
                        XMLEditor.Add(cat.name,
                                      New Dictionary(Of String, String) From {
                                          {"Name", Nm}},
                                      New Dictionary(Of String, String) From {
                                          {"Name", Nm},
                                          {"Lable", Lbl},
                                          {"Path", Pth},
                                          {"Creation_Date", CrtnDt},
                                          {"Opened", 0}}, 0)
                    Next
                Next
            Next
        End Using
    End Function
