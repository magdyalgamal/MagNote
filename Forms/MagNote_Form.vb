    Private Function PrepareShotcutPictureBoxes() As Boolean
        Dim PicSize As Integer = Wallpaper_PctrBx.Width / 86
        Dim remainder As Integer = (Wallpaper_PctrBx.Width Mod 86) / 7
        Dim PctrBxNm As String
        Dim PctrBx As PictureBox
        Dim ChkBx As CheckBox
        For Img = 1 To 21
            PctrBxNm = "PctrBxNm_" & Img & "_PctrBx"
            If FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, PctrBxNm).Count > 0 Then
                Continue For
            End If

            PctrBx = New PictureBox
            ChkBx = New CheckBox
            PctrBx.Name = PctrBxNm
            ChkBx.Name = "ChkBxNm_" & Img & "_ChkBx"
            Dim ImgTop As Integer
            If Img < 8 Then
                PctrBx.Location = New Point(0, 0)
                ImgTop = 0
                PctrBx.Location = New Point(((Img - 1) * 85) + (remainder * (Img - 1)), ImgTop)
            ElseIf Img < 15 And Img > 7 Then
                ImgTop = (1 * 85) + remainder
                PctrBx.Location = New Point(0, ImgTop)
                PctrBx.Location = New Point(((Img - 8) * 85) + (remainder * (Img - 8)), ImgTop)
            ElseIf Img > 14 Then
                ImgTop = (2 * 85) + (remainder * 2)
                PctrBx.Location = New Point(0, ImgTop)
                PctrBx.Location = New Point(((Img - 15) * 85) + (remainder * (Img - 15)), ImgTop)
            End If
            PctrBx.Size = New Size(85, 85)
            PctrBx.SizeMode = PictureBoxSizeMode.Zoom
            ChkBx.Size = New Size(20, 20)
            ChkBx.CheckAlign = ContentAlignment.BottomCenter
            ChkBx.Location = New Point(PctrBx.Left + PctrBx.Width - ChkBx.Width, PctrBx.Top)
            Wallpaper_PctrBx_Pnl.Controls.Add(PctrBx)
            Wallpaper_PctrBx_Pnl.Controls.Add(ChkBx)
            PctrBx.Image = Wallpaper_PctrBx.Image
            PctrBx.Visible = True
            PctrBx.BringToFront()
            ChkBx.Visible = True
            ChkBx.BringToFront()
            AddHandler ChkBx.CheckStateChanged, AddressOf SelectedImagegChkBx_CheckStateChanged
        Next
        Picture_Box_Size_Mode_CmbBx_SelectedIndexChanged(Picture_Box_Size_Mode_CmbBx, EventArgs.Empty)
    End Function

