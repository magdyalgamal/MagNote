    Public Function CleanInvalidXmlChars(input As String) As String
        ' XML 1.0 valid character ranges
        Dim pattern As String = "[^\u0009\u000A\u000D\u0020-\uD7FF\uE000-\uFFFD]|[()]|[ ]|[,]|[;]|[@]|[#]|[$]|[" & vbTab & "]|[%]|[&]|[*]|[.]"
        Return Regex.Replace(input, pattern, "_")
    End Function
    Private Sub Get_WhatsApp_Contacts_Btn_Click(sender As Object, e As EventArgs) Handles Get_WhatsApp_Contacts_Btn.Click
        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Try
            Me.Cursor = Cursors.WaitCursor
            If Not IsConnectedToInternet() Then Exit Sub
            If FillObjectsFirest() Then Exit Sub
            If My_Contacts_List_DGV.Columns.Count = 0 Then
                My_Contacts_List_DGV.Columns.Add("ContactName", "Contact Name")
                My_Contacts_List_DGV.Columns.Add("ContactId", "Contact Id")
                My_Contacts_List_DGV.Columns.Add("ContactType", "Contact Type")
            End If
            If File.Exists(MagNoteFolderPath & "\WhatsAppContants.xml") Then
                If My_Contacts_List_DGV.Rows.Count = 0 Then GoTo FillMyContactsList
                If Language_Btn.Text = "E" Then
                    Msg = "هل تريد إعادة إستيراد بيانات الإتصال مرة اخرى؟"
                Else
                    Msg = "Do You Want To Redownload The Contact Information Again?"
                End If
                If ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False) = DialogResult.Yes Then
                    My.Computer.FileSystem.DeleteFile(MagNoteFolderPath & "\WhatsAppContants.xml", FileIO.UIOption.OnlyErrorDialogs, FileIO.RecycleOption.SendToRecycleBin)
                    Using GAFUL As New GreenApiFileUploader
                        GAFUL.GetWhatsAppContacts(ID_Instance_TxtBx.Text, API_Token_Insance_TxtBx.Text, My_Contacts_List_DGV)
                    End Using
                    Exit Sub
                ElseIf ShowMsgDialogResult = DialogResult.Cancel Then
                    Exit Sub
                End If
            ElseIf Not File.Exists(MagNoteFolderPath & "\WhatsAppContants.xml") Then
                Using GAFUL As New GreenApiFileUploader
                    GAFUL.GetWhatsAppContacts(ID_Instance_TxtBx.Text, API_Token_Insance_TxtBx.Text, My_Contacts_List_DGV)
                    Exit Sub
                End Using
            End If
FillMyContactsList:
            Using XMLEditor As New XMLEditor("WhatsAppContants.xml", "WhatsAppContants")
                My_Contacts_List_DGV.Rows.Clear()
                Dim doc As XDocument = XMLEditor.doc
                Dim ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, doc.Root.Elements("WhatsAppContactName").Count)
                For Each entry In doc.Root.Elements("WhatsAppContactName")
                    progress += ProgressToAdd
                    Previewlbl.Text = "Loading--> " & entry.Element("ContactName")?.Value & vbNewLine & Math.Floor(progress * 100)
                    Previewlbl.Refresh()
                    Previewlbl.Invalidate()
                    My_Contacts_List_DGV.Rows.Add(entry.Element("ContactName")?.Value, entry.Element("ContactId")?.Value, entry.Element("ContactType")?.Value)
                Next
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Me.Cursor = Cursors.Default
            PreviewPnl.Dispose()
            Previewlbl.Dispose()
            LoadMagNote_Groups()
        End Try
    End Sub

