    Protected Overrides Sub WndProc(ByRef m As System.Windows.Forms.Message)
        If m.Msg = WM_QUERYENDSESSION OrElse m.Msg = WM_ENDSESSION Then
            If systemShutdown Then Exit Sub
            systemShutdown = True
            If Not RunAsExternal() Then
                FinalizeShutDown()
                Exit Sub
            End If
        End If
        Const WM_SYSCOMMAND As Integer = &H112
        Const SC_MAXIMIZE As Integer = &HF030
        Const SC_RESTORE As Integer = &HF120
        Const SC_MINIMIZE As Integer = &HF020
        Const SC_CLOSE As Integer = &HF060
        Const SC_TRAYRESTORE As Integer = &HF036
        If m.Msg = WM_SYSCOMMAND AndAlso m.WParam.ToInt32() = SC_MAXIMIZE Then
            IgnoreWinSize = True
            If Show_Form_Border_Style_ChkBx.CheckState = CheckState.Unchecked Then
                MagNote_Header_Pnl.Visible = False
                Me.FormBorderStyle = FormBorderStyle.Sizable
            End If
            If Me_Is_Compressed_ChkBx.CheckState = CheckState.Checked Then
                MeIsCompressed(1)
                Return
            End If
        ElseIf m.Msg = WM_SYSCOMMAND AndAlso m.WParam.ToInt32() = SC_RESTORE Then
            If Show_Form_Border_Style_ChkBx.CheckState = CheckState.Unchecked Then
                MagNote_Header_Pnl.Visible = True
                Me.FormBorderStyle = FormBorderStyle.None
            End If
            ShowMsg("Restore Down button clicked" & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False, 0,,,,,, 0)
            If Me_Is_Compressed_ChkBx.CheckState = CheckState.Checked Then
                Me.Activate()
                MeIsCompressed()
                Return
            End If
        ElseIf m.Msg = WM_SYSCOMMAND AndAlso m.WParam.ToInt32() = SC_MINIMIZE Then
            IgnoreWinSize = True
            ShowMsg("Minimize button clicked" & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False, 0,,,,,, 0)
            If Me_Is_Compressed_ChkBx.CheckState = CheckState.Checked Then
                MeIsCompressed()
                Return
            End If
        ElseIf m.Msg = WM_SYSCOMMAND AndAlso m.WParam.ToInt32() = SC_CLOSE Then
            ShowMsg("Close button clicked" & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False, 0,,,,,, 0)
        End If
        If CurrentDayOfYear <> Today.DayOfYear Then
            CurrentDayOfYear = Today.DayOfYear
            Alert_Tmr.Start()
        End If
        MyBase.WndProc(m)
    End Sub
    Dim MeIsActivated As Boolean
    Private Sub Tray_MouseClick(sender As Object, e As MouseEventArgs) Handles Tray.MouseClick
        If e.Button = MouseButtons.Left Then
            If MeIsActivated And
                Me.WindowState <> FormWindowState.Minimized Then
                Me.WindowState = FormWindowState.Minimized
                Exit Sub
            End If
            If Me.WindowState = FormWindowState.Minimized Then
                If Show_Form_Border_Style_ChkBx.CheckState = CheckState.Unchecked Then
                    MagNote_Header_Pnl.Visible = True
                    Me.FormBorderStyle = FormBorderStyle.None
                    Me.WindowState = FormWindowState.Normal
                Else
                    If Me_Is_Compressed_ChkBx.CheckState = CheckState.Indeterminate Then
                        Me.WindowState = FormWindowState.Maximized
                    ElseIf Me_Is_Compressed_ChkBx.CheckState = CheckState.Unchecked Then
                        Me.WindowState = FormWindowState.Normal
                    ElseIf Me_Is_Compressed_ChkBx.CheckState = CheckState.Checked Then
                        MeIsCompressed()
                        Me.Activate()
                    End If
                End If
            Else
                SetForegroundWindow(Me.Handle)
            End If

            'Me.Show()
            'Me.WindowState = FormWindowState.Normal
            'Me.BringToFront()
            'MessageBox.Show("Restored from tray")

            'If Show_Form_Border_Style_ChkBx.CheckState = CheckState.Unchecked Then
            '    MagNote_Header_Pnl.Visible = False
            '    Me.FormBorderStyle = FormBorderStyle.Sizable
            'End If

        End If
    End Sub
    Private Function StartStopwatch() As Boolean
        Dim sw As New Stopwatch
        ' Pretend work for 3 minutes
        sw.Start()
        Do While sw.ElapsedMilliseconds < 180000
            ApplicationDoEvents(Me)
        Loop
        sw.Stop()
        systemShutdown = False

        Dim p As New ProcessStartInfo("shutdown", "/s /t 0")
        p.CreateNoWindow = True
        p.UseShellExecute = False
        Process.Start(p)
        Application.Exit()
    End Function
    Private Function FinalizeShutDown()
        Exit_Application_Click(Exit_Application, EventArgs.Empty)

        SaveNewChangedNameNote()
        NoteAmendmented(, 1)
        If IfOpenedTabPagesChanged() Then
            SaveOpenedTabPages()
        End If
        RememberOpenedExternalFiles()
        SaveFormParameters(Nothing)
    End Function
