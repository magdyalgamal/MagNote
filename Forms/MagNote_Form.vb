    Private Function Check_For_New_Version(Optional ForceDisplayWindowsNotification As Boolean = False) As Boolean
        Try
            UpdateFileName = String.Empty
            SourceFileName = String.Empty
            DestinationFileName = String.Empty
            UpdateFileVersion = String.Empty
            UpdateDownloadFilePath = String.Empty
            If Language_Btn.Text = "E" Then
                Msg = "جارى التحقق من وجود تحديث للبرنامج"
            ElseIf Language_Btn.Text = "ع" Then
                Msg = "Checking To Find New Version Of The Progarm"
            End If
            ShowWindowsNotification(Msg, ForceDisplayWindowsNotification)
            If Not IsInternetAvailable() Then
                Exit Function
            End If
            DecryptFTPCredentials(Nothing)
            Dim Password As String = ClientCredentials(0).FTP_Password
            Dim UserName As String = ClientCredentials(0).FTP_UserName
            Dim USNFI As String = MagNoteFolderPath & "\AdditionalFilesToUpload.xml"
            Try
                Using client As New WebClient()
                    If File.Exists(USNFI) Then
                        File.Delete(USNFI)
                    End If
                    client.Credentials = New NetworkCredential(UserName, Password)
                    client.DownloadFile(ClientCredentials(0).FTP_Address & "AdditionalFilesToUpload.xml", USNFI)
                End Using
            Catch ex As Exception
                If Language_Btn.Text = "E" Then
                    Msg = "لم تفلح محاولة الاتصال بالمضيف الخاص بالبرنامج"
                ElseIf Language_Btn.Text = "ع" Then
                    Msg = "Couldn't Connect To The Host Of The Progarm"
                End If
                ShowWindowsNotification(Msg & vbNewLine & ex.Message, ForceDisplayWindowsNotification)
                Return False
            End Try
            If File.Exists(USNFI) Then
                SourceFileName = String.Empty
                DestinationFileName = String.Empty
                Dim FileName = String.Empty
                Dim Address = ClientCredentials(0).FTP_Address
                Using XMLEditor As New XMLEditor("AdditionalFilesToUpload.xml", "AdditionalFilesToUpload")
                    Dim MagNoteExe = String.Empty
                    DownloadedFiles = String.Empty
                    For Each entry In XMLEditor.doc.Root.Elements()
                        If Convert.ToBoolean(Val(entry.Element("ActiveFile")?.Value.ToString)) Then
                            FileName = entry.Element("DestinationFilePath")?.Value.ToString
                            UpdateFileVersion = entry.Element("UpdateFileVersion")?.Value.ToString
                            DownloadedFiles &= Path.GetFileName(FileName) & vbNewLine
                        End If
                    Next
                    'DownloadedFiles = Replace(DownloadedFiles, "MagNote.exe" & vbNewLine, "")
                    If DownloadedFiles.Length > 0 Then
                        Return True
                    End If
                End Using
            End If
        Catch ex As Exception
            If Language_Btn.Text = "E" Then
                Msg = "لم تفلح محاولة التحقق من وجود تحيث للبرنامج"
            ElseIf Language_Btn.Text = "ع" Then
                Msg = "Couldn't Check To Find New Version Of The Progarm"
            End If
            ShowMsg(Msg & vbNewLine & ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Stop, MessageBoxDefaultButton.Button2, MBOs, 0, 0)
            Return False
        Finally
            client.Dispose()
        End Try
    End Function
    Public Function UpdateIsAvailable(Optional ByVal form As Form = Nothing) As Boolean
        Try
            If IsNothing(form) Then
                form = Me
            End If
            Dim Update_Version_TxtBx As New TextBox
            Dim CurrentVersionSplit() = Split(My.Application.Info.Version.ToString, ".")
            Dim UpgradeVersionSplit() = Split(UpdateFileVersion, ".")
            Dim Seq = 0
            For Each Value In CurrentVersionSplit
                If Val(CurrentVersionSplit(Seq)) < Val(UpgradeVersionSplit(Seq)) Then
                    If Language_Btn.Text = "E" Then
                        Msg = "تمت بنجاح عملية محاولة التحقق من وجود تحيث للبرنامج"
                    ElseIf Language_Btn.Text = "ع" Then
                        Msg = "Successfully Checked To Find New Version Of The Progarm"
                    End If
                    ShowWindowsNotification(Msg, 1)
                    Return True
                End If
                Seq += 1
            Next

            'If UpdateIsAvailable() Then
            '    If Language_Btn.Text = "E" Then
            '        Msg = "تمت بنجاح عملية محاولة التحقق من وجود تحيث للبرنامج"
            '    ElseIf Language_Btn.Text = "ع" Then
            '        Msg = "Successfully Checked To Find New Version Of The Progarm"
            '    End If
            '    ShowWindowsNotification(Msg, 1)
            '    Return True
            'Else
            If My.Application.Info.Version.ToString = UpdateFileVersion Then
                If Language_Btn.Text = "E" Then
                    Msg = "انت تستخدم آخر إصدار متاح للبرنامج... هل تريد الاستمرار برغم ذلك"
                ElseIf Language_Btn.Text = "ع" Then
                    Msg = "You Are Using The Last Available Version Of The Program..Do you want to continue though?"
                End If
                If ShowMsg(Msg & vbNewLine & UpdateFileVersion, "InfoSysMe (MagNote)", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MBOs, 0, 1,,,,,,, form) = DialogResult.Yes Then
                    Return True
                End If
            Else
                If Language_Btn.Text = "E" Then
                    Msg = "الإصدار الحالى الذى تستخدمه أحدث من إصدار التحديث... هل تريد الاستمرار؟"
                Else
                    Msg = "The current version you are using is newer than the update version... Do you want to continue?"
                End If
                Msg &= vbNewLine & "CurrentVersion = " & My.Application.Info.Version.ToString
                Msg &= vbNewLine & "UpgradeVersion = " & UpdateFileVersion
                If ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MBOs, 0,,,,,,,, form) = DialogResult.Yes Then
                    Return True
                End If
            End If
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False,,,,,,,, form)
        End Try
