    Dim rtb As RichTextBox
    Dim graphics As Graphics
    Dim hdc As IntPtr
    Dim marginBounds As Rectangle
    Dim lParam As IntPtr
    Dim printLength As IntPtr
    Private Sub PrintPageHandler(sender As Object, e As PrintPageEventArgs)
        Try
            rtb = RCSN() ' Assuming you have a RichTextBox named RichTextBox1
            graphics = e.Graphics
            hdc = graphics.GetHdc()
            ' Convert margin bounds to hundredths of an inch (used by the RichTextBox control)
            marginBounds = e.MarginBounds
            Dim marginBoundsInTwips As New RECT1() With {
                .Left = CInt(marginBounds.Left * 14.4F),
                .Top = CInt(marginBounds.Top * 14.4F),
                .Right = CInt(marginBounds.Right * 14.4F),
                .Bottom = CInt(marginBounds.Bottom * 14.4F)
            }

            ' Prepare the FORMATRANGE structure
            Dim formatRange As New FORMATRANGE() With {
                .hdc = hdc,
                .hdcTarget = hdc,
                .rc = marginBoundsInTwips,
                .rcPage = marginBoundsInTwips,
                .chrg = New CHARRANGE() With {
                    .cpMin = currentPrintChar,
                    .cpMax = -1
                }
            }

            ' Allocate memory for the FORMATRANGE structure
            lParam = Marshal.AllocCoTaskMem(Marshal.SizeOf(formatRange))
            Marshal.StructureToPtr(formatRange, lParam, False)

            ' Send EM_FORMATRANGE message to render the content
            printLength = SendMessage(rtb.Handle, EM_FORMATRANGE, CType(1, IntPtr), lParam)

            ' Free allocated memory
            Marshal.FreeCoTaskMem(lParam)
            graphics.ReleaseHdc(hdc)

            ' Update the current character index
            currentPrintChar = printLength.ToInt32()

            ' Determine if there is more content to print
            e.HasMorePages = currentPrintChar < rtb.TextLength
            ' Clear the format range when done
            If Not e.HasMorePages Then
                SendMessage(rtb.Handle, EM_FORMATRANGE, CType(0, IntPtr), IntPtr.Zero)
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification, False)
        Finally
        End Try
    End Sub

    ' Define RECT structure (used by FORMATRANGE)
    <StructLayout(LayoutKind.Sequential)>
    Private Structure RECT1
        Public Left As Integer
        Public Top As Integer
        Public Right As Integer
        Public Bottom As Integer
    End Structure

    ' Define CHARRANGE structure (used by FORMATRANGE)
    <StructLayout(LayoutKind.Sequential)>
    Private Structure CHARRANGE
        Public cpMin As Integer ' Start of the range (character position)
        Public cpMax As Integer ' End of the range (character position)
    End Structure

    ' Define FORMATRANGE structure
    <StructLayout(LayoutKind.Sequential)>
    Private Structure FORMATRANGE
        Public hdc As IntPtr ' HDC for rendering to the printer
        Public hdcTarget As IntPtr ' HDC for measuring (may be the same as hdc)
        Public rc As RECT1 ' Rendering rectangle in twips
        Public rcPage As RECT1 ' Entire page rectangle in twips
        Public chrg As CHARRANGE ' Range of text to render
    End Structure

    Private Sub PreparePrintDocument()
        If printDoc IsNot Nothing Then
            RemoveHandler printDoc.PrintPage, AddressOf PrintPageHandler
            RemoveHandler printDoc.BeginPrint, AddressOf BeginPrintHandler
            RemoveHandler printDoc.EndPrint, AddressOf EndPrintHandler
        End If
        ' Attach event handlers for the new PrintDocument
        printDoc = New PrintDocument()
        AddHandler printDoc.PrintPage, AddressOf PrintPageHandler
        AddHandler printDoc.BeginPrint, AddressOf BeginPrintHandler
        AddHandler printDoc.EndPrint, AddressOf EndPrintHandler
    End Sub

