    Public Sub SendEmail()
        Try
            If Attach_File_TxtBx.TextLength > 0 Then
                'Mail but does not support attachments
                If Language_Btn.Text = "E" Then
                    Msg = "ربما غير متاح ارسال ملفات كمرفقات بهذة الطريقة... يمكنك اضافة الملفات يدويا بعد ظهور برنامج البريد الخاص بك"
                Else
                    Msg = "Maybe It Is Not Possible To Send Files As Aattachments In This Way... You Can Add Files Manually After Your Mail Program Appears."
                End If
                ShowMsg(Msg,, MessageBoxButtons.OK, MessageBoxIcon.Asterisk, MessageBoxDefaultButton.Button2)
            End If
            Dim recipients As String = Mail_To_CmbBx.Text
            Dim subject As String = Mail_Subject_TxtBx.Text
            Dim body As String = Mail_Body_RchTxtBx.Text
            Dim attachment As String = Attach_File_TxtBx.Text
            If With_Current_MagNote_ChkBx.CheckState = CheckState.Checked Then
                body &= vbNewLine & RCSN(0).Text
            End If
            Dim cc As String = Mail_CC_CmbBx.Text
            Dim mailto As String = String.Format("mailto:{0}?cc={1}&subject={2}&body={3}&attachment={4}",
                                             recipients,
                                             Uri.EscapeDataString(cc),
                                             Uri.EscapeDataString(subject),
                                             Uri.EscapeDataString(body),
                                             Uri.EscapeDataString(attachment))
            Process.Start(mailto)
        Catch ex As Exception
            If ex.Message.Contains("The system cannot find the file specified") Then
                If Language_Btn.Text = "E" Then
                    Msg = "النوافذ لم تستطيع العثور على البرنامج الافتراضى لارسال البريد على هذا الجهاز"
                Else
                    Msg = "Windows Couldn't Find The Default Mail Application To Send Mail On This Machine"
                End If
            End If
            ShowMsg(Msg & vbNewLine & ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Me.Cursor = Cursors.Default
        End Try
    End Sub
    Private Function UserAddedFTP() As Boolean
        If SMTP_Mail_User_Name_TxtBx.Text <> "EnterSMTPMailUserName" And
            SMTP_Host_TxtBx.Text <> "EnterSMTPHostServerURL" And
