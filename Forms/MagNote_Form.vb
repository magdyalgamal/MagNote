    <DllImport("user32.dll", CharSet:=CharSet.Auto)>
    Private Shared Function SystemParametersInfo(ByVal uAction As Integer, ByVal uParam As Integer, ByVal lpvParam As String, ByVal fuWinIni As Integer) As Boolean
    End Function

    ' Constants for SystemParametersInfo
    Private Const SPI_SETDESKWALLPAPER As Integer = 20
    Private Const SPIF_UPDATEINIFILE As Integer = &H1
    Private Const SPIF_SENDCHANGE As Integer = &H2

    ' Function to change the desktop background
    Private Sub SetDesktopWallpaper(ByVal wallpaperPath As String)
        ' Change the wallpaper using the SystemParametersInfo function
        If Not File.Exists(wallpaperPath) Then Exit Sub
        SystemParametersInfo(SPI_SETDESKWALLPAPER, 0, wallpaperPath, SPIF_UPDATEINIFILE Or SPIF_SENDCHANGE)
    End Sub

    Private Sub Desktop_Wallpaper_Tmr_Tick(sender As Object, e As EventArgs) Handles Desktop_Wallpaper_Tmr.Tick
        Try
            Desktop_Wallpaper_Tmr.Stop()
            If (Wallpaper_Seconds_NmrcUpDn.Value + Wallpaper_Minutes_NmrcUpDn.Value + Wallpaper_Hours_NmrcUpDn.Value = 0) And
                  (Wallpaper_Every_Day_ChkBx.CheckState = CheckState.Unchecked And
                  Wallpaper_Every_Month_ChkBx.CheckState = CheckState.Unchecked And
                  Wallpaper_Every_Year_ChkBx.CheckState = CheckState.Unchecked) Then
                Exit Sub
            End If
            If Wallpaper_Images_DGV.Rows.Count = 0 Then
                Exit Sub
            End If

            If Next_Time_To_Change_Wallpaper_DtTmPkr.Value <= Now Then
                Wallpaper_Images_DGV.ClearSelection()
                Dim NextWallpaperToChange As String = MagNoteFolderPath & "\NextWallpaperToChange.fil"
                Dim CurrentPicture As DataGridViewRow
                If File.Exists(NextWallpaperToChange) Then
                    Dim CurrentFile As String = My.Computer.FileSystem.ReadAllText(NextWallpaperToChange, System.Text.Encoding.UTF8)
                    CurrentPicture = isInDataGridView(CurrentFile, "File_Path", Wallpaper_Images_DGV, 0, 1)
                    If Not IsNothing(CurrentPicture) Then
                        If (CurrentPicture.Index + 1) > (Wallpaper_Images_DGV.Rows.Count - 1) Then
                            Wallpaper_Images_DGV.CurrentCell = Wallpaper_Images_DGV.Rows(0).Cells(0)
                        Else
                            Wallpaper_Images_DGV.CurrentCell = Wallpaper_Images_DGV.Rows(CurrentPicture.Index + 1).Cells(0)
                        End If
                        If Not IsNothing(Wallpaper_Images_DGV.CurrentRow) Then
                            SetDesktopWallpaper(Wallpaper_Images_DGV.CurrentRow.Cells("File_Path").Value)
                            My.Computer.FileSystem.WriteAllText(NextWallpaperToChange, Wallpaper_Images_DGV.CurrentRow.Cells("File_Path").Value, 0, System.Text.Encoding.UTF8)
                            SetNextTimeToChangeWallpaper()
                        End If
                    Else
                        GoTo SaveNextWallpaperToChange
                    End If
                Else
SaveNextWallpaperToChange:
                    If Wallpaper_Images_DGV.Rows.Count > 0 Then
                        Wallpaper_Images_DGV.CurrentCell = Wallpaper_Images_DGV.Rows(0).Cells(0)
                        SetDesktopWallpaper(Wallpaper_Images_DGV.CurrentRow.Cells("File_Path").Value)
                        My.Computer.FileSystem.WriteAllText(NextWallpaperToChange, Wallpaper_Images_DGV.CurrentRow.Cells("File_Path").Value, 0, System.Text.Encoding.UTF8)
                    End If
                End If
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            If Activate_Desktop_Wallpaper_Periodically_ChkBx.CheckState = CheckState.Checked Then
                Desktop_Wallpaper_Tmr.Start()
            End If
        End Try
    End Sub
    Private Function SetNextTimeToChangeWallpaper() As Boolean
        Try

            Next_Time_To_Change_Wallpaper_DtTmPkr.Value = Now
            Next_Time_To_Change_Wallpaper_DtTmPkr.Value = Next_Time_To_Change_Wallpaper_DtTmPkr.Value.AddSeconds(Wallpaper_Seconds_NmrcUpDn.Value)
            Next_Time_To_Change_Wallpaper_DtTmPkr.Value = Next_Time_To_Change_Wallpaper_DtTmPkr.Value.AddMinutes(Wallpaper_Minutes_NmrcUpDn.Value)
            Next_Time_To_Change_Wallpaper_DtTmPkr.Value = Next_Time_To_Change_Wallpaper_DtTmPkr.Value.AddHours(Wallpaper_Hours_NmrcUpDn.Value)
            If Wallpaper_Every_Day_ChkBx.CheckState = CheckState.Checked Then
                Next_Time_To_Change_Wallpaper_DtTmPkr.Value = Next_Time_To_Change_Wallpaper_DtTmPkr.Value.AddDays(1)
            End If
            If Wallpaper_Every_Month_ChkBx.CheckState = CheckState.Checked Then
                Next_Time_To_Change_Wallpaper_DtTmPkr.Value.AddMonths(1)
