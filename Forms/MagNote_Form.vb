    Private Function CloseOpenedMagNote(MagNoteName As String) As Boolean
        Try
            Using XMLEditor As New XMLEditor("MagNoteGroupsForWhatsApp.xml", "MagNoteGroups")
                XMLEditor.doc.Descendants(MagNoteName.Replace(" ", "_")).Remove()
                XMLEditor.doc.Save(XMLEditor.filePath)
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function
    Private Function NotAplicableToClose(Optional ByVal TbPg = Nothing) As Boolean
        Try
            If TbPg IsNot Nothing Then
                IsInMagNoteCmbBx(TbPg.Name, 1)
            Else
                IsInMagNoteCmbBx(TabPageToClose.Name, 1)
            End If
            ApplicationDoEvents(Me)
            If IsNothing(TabPageToClose) Then
                Return True
            ElseIf TbPg IsNot Nothing Then
                If NoteAmendmented(TbPg.Name) = DialogResult.Cancel Then
                    Return True
                End If
            ElseIf NoteAmendmented(TabPageToClose.Name) = DialogResult.Cancel Then
                Return True
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function
    Private Sub Close_Current_TabPage_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Try
            If NotAplicableToClose() Or ShowMsgDialogResult = DialogResult.Cancel Then
                Exit Sub
            End If

            Cursor = Cursors.WaitCursor
            Dim AryInx = RCSN.Name
            Dim TbPgIndex = MagNotes_Notes_TbCntrl.TabPages.IndexOf(TabPageToClose)
            For Each cntrl In MagNotes_Notes_TbCntrl.TabPages(TbPgIndex).Controls
                cntrl.dispose
            Next
            If Not File.Exists(TabPageToClose.Name) Then
                MagNote_No_CmbBx.Items.Remove(IsInMagNoteCmbBx(TabPageToClose.Tag,,,, 1))
                Try
                    'Available_MagNotes_DGV.Rows.RemoveAt(CType(isInDataGridView(TabPageToClose.Tag, "MagNote_Name", Available_MagNotes_DGV, 0, 1), DataGridViewRow).Index)
                    Dim RowIndex = CType(isInDataGridView(TabPageToClose.Tag, "MagNote_Name", Available_MagNotes_DGV, 0, 1), DataGridViewRow).Index
                    SaveNoteCategory(Available_MagNotes_DGV.Rows(RowIndex).Cells("MagNote_Name").Value,, 0, Available_MagNotes_DGV.Rows(RowIndex).Cells("MagNote_Category").Value)
                    Available_MagNotes_DGV.Rows.RemoveAt(RowIndex)
                Catch ex As Exception
                End Try
            ElseIf MagNoteIsOpenedExternal() Then
                MagNote_No_CmbBx.Items.Remove(IsInMagNoteCmbBx(TabPageToClose.Tag,,,, 1))
            End If
            RemoveMagNoteRTF(AryInx)
            MagNotes_Notes_TbCntrl.TabPages.Remove(MagNotes_Notes_TbCntrl.TabPages(TabPageToClose.Tag))
            FileCount = Nothing
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Cursor = Cursors.Default
