    Private Sub Send_Escalation_To_Author_Btn_Click(sender As Object, e As EventArgs) Handles Send_Mail_Btn.Click
        Try
            Me.Cursor = Cursors.WaitCursor
            If Mail_From_TxtBx.TextLength = 0 Or
                Mail_Body_RchTxtBx.TextLength = 0 Then
                If Language_Btn.Text = "E" Then
                    Msg = "عفوا... يجب ادخال إسم الراسل وشرح الاشكالية المطلوب ارسالها"
                Else
                    Msg = "Pardon... Must Enter The Sender Name And The Escalation Description You Want To Send"
                End If
                ShowMsg(Msg,, MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2)
                Exit Sub
            End If
            If Not UserAddedFTP() Then
                SendEmail()
            Else
                Dim AttatchFile As String = Nothing
                AttatchFile = Attach_File_TxtBx.Text
                If With_Current_MagNote_ChkBx.CheckState = CheckState.Checked Then
                    Dim FileName
                    If DirectCast(File_Format_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Value <> "مفكرة النوافذ (txt)" And DirectCast(File_Format_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Value <> "Text Document (txt)" Then
                        FileName = ApplicationStartupPath & "\" & Path.GetFileNameWithoutExtension(MagNotes_Notes_TbCntrl.SelectedTab.Text) & ".rtf"
                        RCSN(0).SaveFile(FileName, RichTextBoxStreamType.RichText)
                    Else
                        FileName = ApplicationStartupPath & "\" & Path.GetFileNameWithoutExtension(MagNotes_Notes_TbCntrl.SelectedTab.Text) & ".txt"
                        My.Computer.FileSystem.WriteAllText(FileName, RCSN(0).Text, 1, System.Text.Encoding.UTF8)
                    End If
                    If Not String.IsNullOrEmpty(AttatchFile) Then
                        AttatchFile &= "," & FileName
                    Else
                        AttatchFile = FileName
                    End If
                End If
                Using sen As New SentMailInBackground(Mail_Subject_TxtBx.Text, Mail_Body_RchTxtBx, Mail_To_CmbBx.Text, Mail_CC_CmbBx.Text, Nothing, "User Name (" & Mail_From_TxtBx.Text & ")", SMTP_Mail_From_TxtBx.Text, 0, AttatchFile)
                End Using
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Me.Cursor = Cursors.Default
        End Try
    End Sub

