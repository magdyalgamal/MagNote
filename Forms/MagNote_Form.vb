    Private Sub LoadCategories()
        MagNote_Category_CmbBx.Items.Clear()
        Using XMLEditor As New XMLEditor("NewCategories.xml", "Category_Entries")
            Dim docRoot = XMLEditor.Element_Exist("Category_Entries", Nothing,, 1)
            For Each entry In docRoot
                Dim foundByKey = MagNote_Category_CmbBx.Items.OfType(Of KeyValuePair(Of String, String))().FirstOrDefault(Function(x) x.Key = entry.name.ToString)
                If IsNothing(foundByKey.Key) Then
                    MagNote_Category_CmbBx.Items.Add(New KeyValuePair(Of String, String)(entry.name.ToString, Replace(entry.name.ToString, "_", " ")))
                End If
            Next
            MagNote_Category_CmbBx.Text = Nothing
            If Not IsNothing(MagNotes_Notes_TbCntrl.SelectedTab) Then
                MagNote_Category_CmbBx.Text = ReadFile(MagNotes_Notes_TbCntrl.SelectedTab.Name,,,,,,,, 1)
            End If
        End Using
    End Sub
