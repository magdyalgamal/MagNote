    Private Sub Delete_File_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Try
            Dim Objct As Object = DirectCast(DirectCast(sender, ToolStripMenuItem).Owner, ContextMenuStrip).SourceControl
            Dim CurrentLstvw = CType(ShortCut_TbCntrl.Controls(Objct.name).Controls(Objct.name), ListView)
            Dim ShortcutPath = CurrentLstvw.Items(CurrentLstvw.Items.IndexOf(CurrentLstvw.FocusedItem)).Tag
            If File.Exists(ShortcutPath) Then
                My.Computer.FileSystem.DeleteFile(ShortcutPath, FileIO.UIOption.OnlyErrorDialogs, FileIO.RecycleOption.SendToRecycleBin)
DisplyMsg:
                If Language_Btn.Text = "E" Then
                    Msg = "تم ارسال الملف الى سلة المهملات"
                Else
                    Msg = "File Moved To Recycle Bin"
                End If
                ShowMsg(Msg & vbNewLine & ShortcutPath, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False, 0)
                ShortCut_TbCntrl.TabPages.Remove(ShortCut_TbCntrl.TabPages(Objct.name))
                CreatMyDesktopTabPage()
                ShortCut_TbCntrl.SelectedTab = ShortCut_TbCntrl.TabPages("My DeskTop")
            ElseIf IO.Directory.Exists(ShortcutPath) Then
                ' Delete the directory and send it to the Recycle Bin
                FileSystem.DeleteDirectory(ShortcutPath, UIOption.OnlyErrorDialogs, RecycleOption.SendToRecycleBin)
                GoTo DisplyMsg
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub
