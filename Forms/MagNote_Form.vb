    Private Function IsTextOverflowing(sender As Object, e As EventArgs) As Boolean
        ' Measure the size of the text using the TextBox font
        Dim textSize As Size = TextRenderer.MeasureText(sender.Text, sender.Font)

        ' Compare the text width with the TextBox's client area width
        If textSize.Width > sender.ClientSize.Width Then
            Return True
        End If
