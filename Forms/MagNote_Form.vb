                Dim Countries() = My.Computer.FileSystem.ReadAllText(CountriesCSV, System.Text.Encoding.Default).Split(delimiters, StringSplitOptions.None) 'Split(My.Computer.FileSystem.ReadAllText(CountriesCSV, System.Text.Encoding.Default), vbCrLf)
