                Msg = "هل تريد اضافة الملفات المختارة الى الملفات السابقة ؟"
            Else
                Msg = "Do You Want To Add Selected Files To Previous Files?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                Wallpaper_Images_DGV.Rows.Clear()
            End If
            If Not String.IsNullOrEmpty(Search_Result_DGV.Rows(0).Cells("File_Name").Value) Then
