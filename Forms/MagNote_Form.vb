    Private Sub RchTxtBx_SelectionChanged(sender As Object, e As EventArgs)
        Try
            If Not Find_Form.Visible Then Exit Sub
            Dim StackNo = 0
            Dim st As New StackTrace()
            For Each sf As StackFrame In st.GetFrames()
                Dim method As MethodBase = sf.GetMethod()
                If method.Name = Find_Form.FindNext_Btn.Name & "_Click" Or
                    method.Name = Find_Form.FindAll_Btn.Name & "_Click" Or
                    method.Name = Find_Form.ReplaceNext_Btn.Name & "_Click" Or
                    method.Name = Find_Form.ReplaceAll_Btn.Name & "_Click" Or
                    method.Name = Find_Form.Clear_Search_Result_Btn.Name & "_Click" Then
                    Exit Sub
                End If
                StackNo += 1
            Next
            If IsNothing(ActiveControl) Then Exit Sub
            If ActiveControl.Name = sender.name Then
                Find_Form.Selection_Start_TxtBx.Text = RCSN(0).SelectionStart
                Find_Form.Selection_End_TxtBx.Text = RCSN(0).SelectionStart + RCSN(0).SelectionLength
                Find_Form.Selection_Length_TxtBx.Text = RCSN(0).SelectionLength
                Find_Form.RCSN_Text_Length_TxtBx.Text = RCSN(0).Text.Length
            End If
        Catch ex As Exception
        Finally
        End Try
