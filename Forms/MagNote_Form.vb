                    Country_CmbBx.Items.Add(Country)
                Next
            ElseIf File.Exists(ApplicationStartupPath & "\WorldCountriesCitiesLatitudeLongitude.csv") Then

                Dim Countries() = My.Computer.FileSystem.ReadAllText(ApplicationStartupPath & "\WorldCountriesCitiesLatitudeLongitude.csv", System.Text.Encoding.Default).Split(delimiters, StringSplitOptions.None) 'Split(My.Computer.FileSystem.ReadAllText(ApplicationStartupPath & "\WorldCountriesCitiesLatitudeLongitude.csv", System.Text.Encoding.Default), vbCrLf)
