    Private Function UploadAdditionalFiles(AFTU, Address, UserName, Password) As Boolean
        Try
            'read UploadAdditionalFiles and upload the files
            Dim Liens() = Split(My.Computer.FileSystem.ReadAllText(AFTU, System.Text.Encoding.UTF8), ",")
            Dim LocalFile, DestinationFile
            Dim DestinationIsDirectory As Boolean = False
            For Each Line In Liens
                If Microsoft.VisualBasic.Left(Line, 2).Equals("\\") Then
                    Continue For
                End If
                Line = Replace(Line, vbLf, "")
                If IsNothing(Line) Then Continue For
                If Line.Equals("DownloadFiles") Then Continue For
                Select Case True
                    Case Microsoft.VisualBasic.Left(Line, 2).Equals("\\")
                        Continue For
                    Case Line.Contains("Source File Name:")
                        LocalFile = Replace(Line, "Source File Name:", "")
                        Try
                            If Directory.Exists(LocalFile) Then
                                DestinationIsDirectory = True
                            End If
                        Catch ex As Exception
                        End Try
                    Case Line.Contains("Destination File Name:")
                        DestinationFile = Replace(Line, "Destination File Name:", "")
                        If Not DestinationIsDirectory Then
                            DestinationFile = Path.GetFileName(DestinationFile)
                            If IsNothing(DestinationFile) Then
                                DestinationFile = Replace(Replace(Line, "Destination File Name:", ""), vbLf, "")
                            End If
                        End If
                    Case Line.Equals("EndFileInformation") 'Upload
                        If Not DestinationIsDirectory Then
                            If Not UploadFileToFtpUsingWebClient(LocalFile, Address & DestinationFile, UserName, Password) Then
                                Continue For
                            End If
                        Else
                            UploadFolderToFTP(LocalFile, Address, UserName, Password)
                            DestinationIsDirectory = False
                        End If
                End Select
            Next
            Return True
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try

    End Function
    Public Function UploadFileToFtpUsingWebClient(filePath As String, ftpUri As String, username As String, password As String) As Boolean
        Try

            Using client As New WebClient()
                client.Credentials = New NetworkCredential(username, password)
                client.UploadFile(New Uri(ftpUri), WebRequestMethods.Ftp.UploadFile, filePath)
            End Using
            Return True
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try

    End Function

    Private Sub UploadFolderToFTP(localFolderPath As String, ftpServer As String, username As String, password As String)
        'Dim ftpServer As String = "ftp://yourserver.com/yourfolder/" ' Must end with /
        'Dim username As String = "yourUsername"
        'Dim password As String = "yourPassword"
        'Dim localFolderPath As String = "C:\YourLocalFolder\" ' Local folder you want to upload
        Dim directoryPath As String = Path.GetDirectoryName(localFolderPath & "\dummy.txt")
        ' Then get the last folder name
        Dim lastDirectory As String = Path.GetFileName(directoryPath)

        Dim allFiles() As String = Directory.GetFiles(localFolderPath, "*.*", System.IO.SearchOption.AllDirectories)

        Dim client As New WebClient()
        client.Credentials = New NetworkCredential(username, password)

        For Each filePath As String In allFiles
            Try
                ' Get relative path for creating same folder structure on server
                Dim relativePath As String = filePath.Substring(localFolderPath.Length).Replace("\", "/")
                Dim uploadUrl As String = ftpServer & relativePath

                ' Before uploading, ensure the directory exists on FTP
                Dim folderPath As String = Path.GetDirectoryName(uploadUrl)
                CreateFtpDirectoryIfNotExists(folderPath, username, password)

                ' Upload file
                client.UploadFile(uploadUrl, WebRequestMethods.Ftp.UploadFile, filePath)
                Console.WriteLine("Uploaded: " & relativePath)

            Catch ex As Exception
                MessageBox.Show("Failed to upload: " & filePath & vbCrLf & ex.Message)
            End Try
        Next

        client.Dispose()

        MessageBox.Show("All files uploaded!")
    End Sub

    Private Sub CreateFtpDirectoryIfNotExists(folderUrl As String, username As String, password As String)
        Try
            ' Try to get the folder details
            Dim request As FtpWebRequest = CType(WebRequest.Create(folderUrl), FtpWebRequest)
            request.Credentials = New NetworkCredential(username, password)
            request.Method = WebRequestMethods.Ftp.ListDirectory
            request.GetResponse().Close()
        Catch ex As WebException
            ' If the folder does not exist, create it
            Dim request As FtpWebRequest = CType(WebRequest.Create(folderUrl), FtpWebRequest)
            request.Credentials = New NetworkCredential(username, password)
            request.Method = WebRequestMethods.Ftp.MakeDirectory
            request.GetResponse().Close()
        End Try
    End Sub


    Public Function DecryptFTPCredentials(ByVal MyEncryptionKey As String) As Boolean
        Try
            If IsNothing(MyEncryptionKey) Then
                MyEncryptionKey = EncryptionKey
            End If
            If Not File.Exists(MagNoteFolderPath & "\" & "FTPCredentials.fil") Then Exit Function
            Dim Credentials() As String
            Credentials = My.Computer.FileSystem.ReadAllText(MagNoteFolderPath & "\" & "FTPCredentials.fil", System.Text.Encoding.UTF8).Split(delimiters, StringSplitOptions.None)
            Dim LineNo = 0
            ReDim ClientCredentials(0)
            For Each Credential In Credentials
                Select Case LineNo
                    Case 0
                        ClientCredentials(0).FTP_Address = Decrypt_Function(Credential, MyEncryptionKey, 0, 1)
                    Case 1
                        ClientCredentials(0).FTP_UserName = Decrypt_Function(Credential, MyEncryptionKey, 0, 1)
                    Case 2
                        ClientCredentials(0).FTP_Password = Decrypt_Function(Credential, MyEncryptionKey, 0, 1)
                End Select
                LineNo += 1
            Next
            Return True
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function

