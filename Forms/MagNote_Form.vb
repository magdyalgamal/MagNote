            If (File.Exists(MagNotes_Notes_TbCntrl.SelectedTab.Name) And
                Not MagNoteIsOpenedExternal()) Or
                New StackFrame(2).GetMethod().Name.Contains("MagNotes_Notes_TbCntrl_SelectedIndexChanged") Or
