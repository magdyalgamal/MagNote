    Public Function MagNoteFileFormat(Optional ByVal FileName As String = Nothing,
                                         Optional ByVal ReturnTrueOrFalse As Boolean = False,
                                         Optional ByVal AddFileToMagNoteComboBox As Boolean = True) As Boolean
        Try
            If AddFileToMagNoteComboBox Then
                AddAvailable_MagNotes_DGVColumns()
            End If
            Dim NoteFileNameFormat = "MagNote -()-"
            Dim FileToRead
            If Not String.IsNullOrEmpty(FileName) Then
                FileToRead = FileName
            ElseIf MagNote_No_CmbBx.SelectedIndex = -1 Then
                Return True
            Else
                FileToRead = DirectCast(MagNote_No_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key
            End If
            Dim FileToReadFormate As String
            Dim FlNm = Path.GetFileNameWithoutExtension(FileToRead)
            FileToReadFormate = Microsoft.VisualBasic.Left(FlNm, ("MagNote -(").Length) & Microsoft.VisualBasic.Right(FlNm, (")-").Length)
            FileToReadFormate &= Path.GetExtension(FileToRead)
            NoteFileNameFormat &= ".txt"
            If FileToRead.Length <= NoteFileNameFormat.Length Then
            ElseIf FileToReadFormate = NoteFileNameFormat Then
                If ReturnTrueOrFalse Then
                    Return True
                Else
                    If AddFileToMagNoteComboBox Then
                        ReadFile(FileToRead,, 1,,, 1)
                    Else
                        ReadFile(FileToRead,, 1)
                    End If
                    Return True
                End If
            End If
        Catch ex As Exception
        Finally
        End Try
    End Function
    Dim MgNtsNtsTbCntrlSlctdTb As Boolean
    Public Function MagNoteIsOpenedExternal() As Boolean
        Try
            If IsNothing(MagNotes_Notes_TbCntrl.SelectedTab) Then Exit Function
            Dim OpenedExternal As Boolean = False
            If Not IsNothing(OpenedExternalFiles(0)) And
                Not IsNothing(RCSN(0)) Then
                Dim RCSNName As String = RCSN(0).Name
                Dim SelectedTabName = MagNotes_Notes_TbCntrl.SelectedTab.Name
                For Each file In OpenedExternalFiles
                    If file = RCSNName Or
                        file = SelectedTabName Then
                        OpenedExternal = True
                    End If
                Next
            End If
            If OpenedExternal Then
                Return True
            ElseIf Not IsNothing(MagNotes_Notes_TbCntrl.SelectedTab) Then
                If Not File.Exists(MagNotes_Notes_TbCntrl.SelectedTab.Name) And
                    Not MagNoteFileFormat(, 1, 0) Then
                    MgNtsNtsTbCntrlSlctdTb = True
                End If
            End If
            If Not MagNoteFileFormat(MagNotes_Notes_TbCntrl.SelectedTab.Name, 1, 0) Or
            MgNtsNtsTbCntrlSlctdTb Then
                Return True
            End If
        Catch ex As Exception
        Finally
            MgNtsNtsTbCntrlSlctdTb = False
        End Try
    End Function
    Public Sub Language_Btn_Click(sender As Object, e As EventArgs, Optional ByVal IgnoreChangeLanguage As Boolean = False) Handles Language_Btn.Click
        Try
            Cursor = Cursors.WaitCursor
            Dim myCurrentLanguage As InputLanguage = InputLanguage.CurrentInputLanguage
            Dim myInputLanguage As InputLanguageCollection = InputLanguage.InstalledInputLanguages
            Select Case Language_Btn.Text
                Case <> "ع"
                    For Each language In myInputLanguage
                        If myCurrentLanguage.LayoutName <> language.LayoutName Then
                            InputLanguage.CurrentInputLanguage = language
                        End If
                    Next
                    If Not IgnoreChangeLanguage Then
                        LabelingForm("English")
                        RightToLeftLayout = False
                        RightToLeft = RightToLeft.No
                        Language_Btn.Text = "ع"
                    Else
                        LabelingForm("Arabic")
                    End If
                Case <> "E"
                    For Each language In myInputLanguage
                        If myCurrentLanguage.LayoutName <> language.LayoutName Then
                            InputLanguage.CurrentInputLanguage = language
                        End If
                    Next
                    If Not IgnoreChangeLanguage Then
                        LabelingForm("Arabic")
                        Language_Btn.Text = "E"
                    Else
                        LabelingForm("English")
                    End If
            End Select
            ApplicationDoEvents(Me)
