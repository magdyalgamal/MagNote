                                    Msg = "Do You Want To Remove The Grid From The MagNote?"
                                End If
                                If ShowMsg(Msg & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MBOs, False) = DialogResult.No Then
                                    TextToWrite &= ":MagNote_Grid -(" & Replace(MagNoteRow.cells("MagNote_Grid").value, ":", "(Instead Of Colon)") & ")-"
                                End If
                            End If
                        End If
                    End If
                End If
                My.Computer.FileSystem.WriteAllText(FileNameToSavePath, TextToWrite, 0, System.Text.Encoding.UTF8)
                'MagNotes_Notes_TbCntrl.SelectedTab.Text = MagNote_No_CmbBx.Text
                SaveMagNoteLinks()
                SaveNoteCategory(FileNameToSavePath)
                If systemShutdown Then
                    GoTo ExitSubsystemShutdown
                End If
                If Language_Btn.Text = "ع" Then
                    Msg = "The File And Its Parmeters Updated Successfully"
                Else
                    Msg = "تم حفظ الملف ومعلماته بنجاح"
                End If
                RefreshAvailableMagNotesDGV(FileNameToSavePath)
                AddMagNoteRTF(1)
                If Reload_MagNotes_After_Amendments_ChkBx.CheckState = CheckState.Unchecked And
                    Warning_Before_Save_ChkBx.CheckState = CheckState.Checked Then
                    If Language_Btn.Text = "E" Then
                        Msg &= "... هل هل تريد اعادة تحميل الماجنوتات بعد التحديث؟"
                    Else
                        Msg = "... Do You Want To Reload The MagNotes After Update?"
                    End If
                    If ShowMsg(Msg & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MBOs, False,,,,,,,, Me) = DialogResult.Yes Then
                        Preview_Btn_Click(Preview_Btn, EventArgs.Empty)
                    End If
                Else
ExitSubsystemShutdown:
                    If File.Exists(FileNameToSavePath) And
                        Reload_MagNotes_After_Amendments_ChkBx.CheckState = CheckState.Unchecked Then
                        If isInDataGridView(FileNameToSavePath, "MagNote_Name", Available_MagNotes_DGV, 0,,, 1) Then
                            ReadFile(FileNameToSavePath,, 1, Available_MagNotes_DGV.CurrentRow)
                        Else
                            ReadFile(FileNameToSavePath,, 1)
                        End If
                        RefreshAvailableMagNotesDGV(FileNameToSavePath)
                    End If
                    If Not IgnoreDisMsg Then
                        ShowMsg(Msg & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MBOs, False, DisplayMsg,,,,,,, Me)
                    End If
                End If
                CommingFromSaveToolStripButton = True
                FileCount = String.Empty
                If Reload_MagNotes_After_Amendments_ChkBx.CheckState = CheckState.Checked And
                    Not systemShutdown Then
                    Dim SelectedItem = MagNote_No_CmbBx.Text
