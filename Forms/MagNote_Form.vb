    Public Function SaveNoteCategory(ByVal NoteName As String,
                                      Optional ByVal AskQuestion As Boolean = False,
                                      Optional ByVal MagNoteIsOpened As Object = Nothing,
                                      Optional ByVal MagNoteCategory As Object = Nothing) As Boolean
        Try
            If MagNote_Category_CmbBx.Text.Length = 0 Then
                Exit Function
            End If
            If IsNothing(MagNoteIsOpened) Then
                MagNoteIsOpened = Convert.ToInt16(isInDataGridView(NoteName, "MagNote_Name", Available_MagNotes_DGV, 0,,, 1))
            Else
                MagNoteIsOpened = Convert.ToInt16(MagNoteIsOpened)
            End If
            If IsNothing(MagNoteCategory) Then
                MagNoteCategory = Replace(MagNote_Category_CmbBx.Text, Space(1), "_")
            Else
                MagNoteCategory = Replace(MagNoteCategory, Space(1), "_")
            End If
            Using XMLEditor As New XMLEditor("NewCategories.xml", "Category_Entries")
                Dim Nm = Path.GetFileName(NoteName)
                Dim Lbl = GetMagNoteLble(NoteName)
                If IsNothing(Lbl) Then
                    Lbl = String.Empty
                End If
                Dim OldMagNoteCategory = Replace(ReadFile(NoteName,,,,,,,, 1), " ", "_")
                If OldMagNoteCategory <> MagNoteCategory Then
                    XMLEditor.RenmeElement(OldMagNoteCategory, MagNoteCategory, New Dictionary(Of String, String) From {{"Path", NoteName}})
                    XMLEditor.doc.Save(XMLEditor.filePath)
                Else
                    XMLEditor.Add(MagNoteCategory,
                              New Dictionary(Of String, String) From {
                                  {"Path", NoteName}},
                              New Dictionary(Of String, String) From {
                                  {"Name", Nm},
                                  {"Lable", Lbl.ToString},
                                  {"Path", NoteName},
                                  {"Creation_Date", Now},
                                  {"Opened", MagNoteIsOpened}}, AskQuestion,,,, 1)
                End If
                Return True
            End Using
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, 0,,,,,,,, Me)
        End Try
    End Function
    Private Function GetMagNoteLble(MagNoteName) As String
        If File.Exists(MagNoteName) Then
            For Each Line In Split(My.Computer.FileSystem.ReadAllText(MagNoteName, System.Text.Encoding.UTF8), ":")
                Select Case True
                    Case Line.Contains("MagNote_Label -(")
                        Dim Lbl = Replace(Line, "MagNote_Label -(", "")
                        Lbl = (Microsoft.VisualBasic.Left(Lbl, Lbl.ToLower.Length - 2))
                        Return Lbl
                        Exit For
                End Select
            Next
        End If
    End Function

