    Public Sub AddModifyConnectionString(ByVal ConnectionStringName As String, ByVal ConnectionStringSetting As String, ByVal ProviderName As String)
        Dim config As Configuration = ConfigurationManager.OpenExeConfiguration(ConfigurationUserLevel.None)
        Dim connectionStrings As ConnectionStringsSection = config.ConnectionStrings
        If connectionStrings.ConnectionStrings(ConnectionStringName) Is Nothing Then
            connectionStrings.ConnectionStrings.Add(New ConnectionStringSettings(ConnectionStringName, ConnectionStringSetting, ProviderName))
        Else
            connectionStrings.ConnectionStrings(ConnectionStringName).ConnectionString = ConnectionStringSetting
        End If
        config.Save(ConfigurationSaveMode.Modified)
        ConfigurationManager.RefreshSection("connectionStrings")
    End Sub

    Private Sub Check_Connection_Btn_Click(sender As Object, e As EventArgs) Handles Check_Connection_Btn.Click
        Try
            Check_Connection_Btn.BackgroundImage = My.Resources.NotConnected
            Me.Cursor = Cursors.WaitCursor
            If SQL_Connection_String_TxtBx.TextLength > 0 And Available_SQL_Conn_Strings_CmbBx.SelectedIndex = -1 And Available_SQL_Conn_Strings_CmbBx.Text.Length > 0 Then
                If Language_Btn.Text = "E" Then
                    Msg = "صيغة الاتصال بقاعدة البيانات هذه غير مسجلة من قبل... هل تريد اضافتها الى ملف نظام تكوين التطبيق؟"
                Else
                    Msg = "This Connection String Is Not Exist, Do You Want To Add It To Application Config Sys?"
                End If
                If ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False) = DialogResult.No Then
                    Exit Sub
                End If
                Using QS As New Query_Class("Users")
                    If Not QS.TestConnection(SQL_Connection_String_TxtBx.Text) Then
                        Exit Sub
                    End If
                End Using
                AddModifyConnectionString(Available_SQL_Conn_Strings_CmbBx.Text, SQL_Connection_String_TxtBx.Text, "System.Data.SqlClient")
                Available_SQL_Conn_Strings_CmbBx.Items.Add(New KeyValuePair(Of String, String)(SQL_Connection_String_TxtBx.Text, Available_SQL_Conn_Strings_CmbBx.Text))
                Dim DataBaseName = Available_SQL_Conn_Strings_CmbBx.Text
                Available_SQL_Conn_Strings_CmbBx.SelectedIndex = -1
                Available_SQL_Conn_Strings_CmbBx.Text = Nothing
                Available_SQL_Conn_Strings_CmbBx.Text = DataBaseName
            ElseIf Available_SQL_Conn_Strings_CmbBx.SelectedIndex <> -1 Then
                SQL_Connection_String_TxtBx.Text = DirectCast(Available_SQL_Conn_Strings_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key
            Else
                If Language_Btn.Text = "E" Then
                    Msg = "من فضلك... إختر صيغة الاتصال بقاعدة البيانات المناسبة لك اولا... اوأدخل الإسم الجديد لصيغة الاتصال الجديدة وادخال صيغة الاتصال المناسبة ليتم إضافتها"
                Else
                    Msg = "Kindly Select Connection String First, Or Enter The New Connection String Name And The Connection String Phrase To Add It"
                End If
                ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
                Exit Sub
            End If
            User_Name_CmbBx.Items.Clear()
            Using QS As New Query_Class("Users")
                If Not OpenDBStatus Then
                    Available_SQL_Conn_Strings_CmbBx.SelectedIndex = -1
                    AddModifyAppSetting("Available_SQL_Conn_Strings", String.Empty)
                    Exit Sub
                End If
                AddModifyAppSetting("Available_SQL_Conn_Strings", Available_SQL_Conn_Strings_CmbBx.Text)
                AddModifyConnectionString(Available_SQL_Conn_Strings_CmbBx.Text, SQL_Connection_String_TxtBx.Text, "System.Data.SqlClient")
                If QS.QueryFieldValue() Then
                    For Each User In QS.Query_DT.Rows
                        User_Name_CmbBx.Items.Add(New KeyValuePair(Of String, String)(User.item("User_No"), User.item("User_Name")))
                    Next
                End If
                If QS.OldRecord Then
                    Activate_Projects_TabPage_ChkBx.CheckState = CheckState.Checked
                    Projects_TbCntrl.TabPages("Users_TbPg").Enabled = True
                Else
                    Activate_Projects_TabPage_ChkBx.CheckState = CheckState.Unchecked
                    Projects_TbCntrl.TabPages("Users_TbPg").Enabled = False
                End If
            End Using
            Check_Connection_Btn.BackgroundImage = My.Resources.Connected
            If Language_Btn.Text = "E" Then
                Msg = "تم الاتصال بقاعدة البيانات بنجاح"
            Else
                Msg = "Connecting To The Database Done Successfully"
            End If
            ShowMsg(Msg & vbNewLine & DirectCast(Available_SQL_Conn_Strings_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Value, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Catch ex As Exception
            Check_Connection_Btn.BackgroundImage = My.Resources.NotConnected
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Me.Cursor = Cursors.Default
