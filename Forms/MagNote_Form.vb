    Private Sub WallPaperWorker_DoWork(sender As Object, e As DoWorkEventArgs) Handles WallPaperWorker.DoWork
        Try
            Try
                Setting_TbCntrl.TabPages("Desktop_Wallpaper_TbPg").Enabled = False
                Dim FileName = MagNoteFolderPath & "\MagNoteDesktopWallpaper.fil"
                Dim ImageDimension As String = String.Empty
                If Use_Folder_Contents_ChkBx.CheckState = CheckState.Checked Then
                    If File.Exists(FileName) Then
                        Dim WallpaperFolder = My.Computer.FileSystem.ReadAllText(FileName, System.Text.Encoding.UTF8).Split(delimiters, StringSplitOptions.None)
                        dt = New DataTable("Wallpaper")
                        dt.Columns.Add("File_Path", GetType(String))
                        dt.Columns.Add("File_Name", GetType(String))
                        dt.Columns.Add("File_Size", GetType(Integer))
                        dt.Columns.Add("Image_Width", GetType(Integer))
                        dt.Columns.Add("Image_Height", GetType(Integer))
                        For Each Folder In WallpaperFolder
                            If String.IsNullOrEmpty(Folder) Then Continue For
                            Dim FolderFiles = DoRecursiveSearch(Folder,,,,, 1)
                            If IsNothing(FolderFiles) Then
                                Continue For
                            End If
                            Dim Cnt = FolderFiles.Count
                            Try
                                For Each pic In DoRecursiveSearch(Folder,,,,, 1)
                                    Try
                                        ImageDimension = ReturnImageInfo(pic)
                                        If Not String.IsNullOrEmpty(ImageDimension) Then
                                            If Not ImageDimension.Equals(",,") Then
                                                dt.Rows.Add(pic, Path.GetFileName(pic), Split(ImageDimension, ",").ToList.Item(0), Split(ImageDimension, ",").ToList.Item(1), Split(ImageDimension, ",").ToList.Item(2))
                                            End If
                                        End If
                                    Catch ex As Exception
                                    End Try
                                Next
                            Catch ex As Exception
                            End Try
                        Next
                    End If
                Else
                    If File.Exists(FileName) Then
                        dt = New DataTable("Wallpaper")
                        dt.Columns.Add("File_Path", GetType(String))
                        dt.Columns.Add("File_Name", GetType(String))
                        Dim Wallpaper() As String
                        Wallpaper = My.Computer.FileSystem.ReadAllText(FileName, System.Text.Encoding.UTF8).Split(delimiters, StringSplitOptions.None)
                        For Each Fil In Wallpaper
                            If String.IsNullOrEmpty(Fil) Then Continue For
                            dt.Rows.Add(Split(Fil, ",").ToList(0), Split(Fil, ",").ToList(1))
                        Next
                    End If
                End If
                e.Result = dt ' Store result to pass to RunWorkerCompleted
            Catch ex As Exception
                ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False, 0)
            End Try
        Catch ex As Exception
            e.Result = ex ' Pass the exception to RunWorkerCompleted
        End Try
    End Sub
    Private Sub WallPaperWorker_RunWorkerCompleted(sender As Object, e As RunWorkerCompletedEventArgs) Handles WallPaperWorker.RunWorkerCompleted
        Try
            If e.Error IsNot Nothing Then
                ShowMsg(e.Error.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
            ElseIf TypeOf e.Result Is Exception Then
                ShowMsg(CType(e.Result, Exception).Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
            Else
                If Wallpaper_Images_DGV.Columns.Count = 0 Then
                    AddAlertFilesDGVColumn(Wallpaper_Images_DGV)
                End If
                dt = CType(e.Result, DataTable)
                If dt.Rows.Count > 0 Then
                    For Each Row In dt.Rows
                        Try
                            If dt.Columns.Count > 2 Then
                                Wallpaper_Images_DGV.Rows.Add(Row("File_Path"), Row("File_Name"), Row("File_Size"), Row("Image_Width"), Row("Image_Height"))
                            Else
                                Wallpaper_Images_DGV.Rows.Add(Row("File_Path"), Row("File_Name"))
                            End If
                        Catch ex As Exception
                            ShowMsg(ex.Message & Row("File_Path"), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
                        End Try
                    Next
                    If Language_Btn.Text = "E" Then
                        Msg = "تم الانتهاء من تحميل ملفات خلفيات سطح المكتب"
                    Else
                        Msg = "Desktop Wallpaper Files Loaded"
                    End If
                    ShowMsg(Msg & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, 0, 0,,,,,, 0)
                    Desktop_Wallpaper_Tmr.Start()
                End If
            End If
            Setting_TbCntrl.TabPages("Desktop_Wallpaper_TbPg").Enabled = True
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
            Setting_TbCntrl.TabPages("Desktop_Wallpaper_TbPg").Enabled = True
        End Try
