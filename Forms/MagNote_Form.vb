                        If Not File.Exists(TbPg.tag) Then
                            Continue For
                        End If
                        MNNCmbBxValidating = True
                        If NoteAmendmented(TbPg.Name) <> DialogResult.Cancel Then
                            MagNotes_Notes_TbCntrl.TabPages.Remove(TbPg)
