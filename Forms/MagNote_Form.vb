    Public Sub UnlockBitLockerDrive(driveLetter As String, password As String)
        'Debugger.Launch()
        Try
            If Language_Btn.Text = "E" Then
                Msg = "هل انت متأكد... سيتم فتح قفل البيتلوكر الخاص بمحرك القرص هذا؟"
            Else
                Msg = "Are You Sure...The BitLocker For This Drive Will Be Unlocked?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2,) = DialogResult.No Then
                Exit Sub
            End If
            Dim psi As New ProcessStartInfo()
            psi.FileName = "manage-bde"
            psi.Arguments = $"-unlock {Replace(driveLetter, ":\", "")}: -password {password}"
            psi.UseShellExecute = False
            psi.RedirectStandardOutput = True
            psi.CreateNoWindow = True
            psi.Verb = "runas" ' Run as administrator
            Dim proc As Process = Process.Start(psi)
            proc.WaitForExit()
            Dim output As String = proc.StandardOutput.ReadToEnd()
            If LCase(output).Contains(LCase("Error")) Then
                If Language_Btn.Text = "E" Then
                    Msg = "لم تفلح محاولة فك قفل البيتلوكر بطريقة آلية... هل تريد فك قفل البيتلوكر بالطريقة اليدوية؟"
                Else
                    Msg = "Failed To Unlock BitLocker By Automatic Way... Do You Want To Unlock BitLocker Using Manual Way?"
                End If
                Msg &= vbNewLine & "Output:" & vbCrLf & output
                If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2, MBOs, 0,,,,,,,, Me) = DialogResult.Yes Then
                    psi = New ProcessStartInfo()
                    psi.FileName = "cmd.exe"
                    Dim Argmnts As String = $"/k manage-bde -unlock {Replace(driveLetter, ":\", "")}: -password"
                    psi.Arguments = Argmnts
                    psi.Verb = "runas" ' Runs as administrator
                    psi.UseShellExecute = True ' Required for Verb to work
                    psi.WindowStyle = ProcessWindowStyle.Normal
                    Try
                        Process.Start(psi)
                        My.Computer.Clipboard.SetText(BitLocker_Drive_Password_TxtBx.Text.ToString)
                    Catch ex As Exception
                        ShowMsg("Failed to start CMD as admin: " & ex.Message,, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MBOs, 0,,,,,,,, Me)
                    End Try
                End If
            Else
                ShowMsg("Output:" & vbCrLf & output,, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MBOs, 0,,,,,,,, Me)
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

