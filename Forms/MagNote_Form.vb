        'Debugger.Launch()
        ActiveControl = RCSN()
        Dim FileName = MagNotes_Notes_TbCntrl.SelectedTab.Tag
        Dim array() As String = ReadFile(FileName, 1)
        '01 MagNote_Name_Value,
        '02 MagNote_Label_Value,
        '03 MagNote_Category_Value,
        '04 MagNote_Value,
        '05 Blocked_Note_Value,
        '06 Finished_Note_Value,
