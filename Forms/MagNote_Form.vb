    ''' <summary>
    ''' Save Datagridview Contents Till Concat It Into Life File
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    Private Sub Save_Search_Result_Btn_Click(sender As Object, e As EventArgs) Handles Save_Search_Result_Btn.Click
        Try
            If Search_Result_DGV.Rows.Count = 0 Then Exit Sub
            Dim TextToWrite As String
            Dim OpenFileDialog As New SaveFileDialog
            If Not String.IsNullOrEmpty(Search_Result_DGV.Rows(0).Cells("File_Name").Value) Then
                Dim FileNameToSave = MagNoteFolderPath & "\" & Replace(Path.GetDirectoryName(Search_Result_DGV.Rows(0).Cells("File_Path").Value), ":", "_") & ".txt"
                If Not File.Exists(FileNameToSave) Then
                    If Language_Btn.Text = "E" Then
                        Msg = "إختار الملف الى تريد حفظة اولا؟"
                    Else
                        Msg = "Select The File You Want To Save First?"
                    End If
                    ShowMsg(Msg,, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2)

                    OpenFileDialog.Title = "Saving Files"
                    OpenFileDialog.Filter = "Current File|" & Path.GetFileName(FileNameToSave) & "|Text Files|*.txt|All files|*.*"

                    OpenFileDialog.FileName = Path.GetFileName(FileNameToSave)
                    If MagNote_No_CmbBx.SelectedIndex <> -1 Then
                        OpenFileDialog.InitialDirectory = Path.GetDirectoryName(DirectCast(MagNote_No_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key)
                    End If
                    If OpenFileDialog.ShowDialog = DialogResult.Cancel Then
                        Exit Sub
                    End If
                End If
                For Each File In Search_Result_DGV.Rows
                    TextToWrite &= File.cells("File_Path").value & "," &
                                            File.cells("File_Name").value & "," &
                                            File.cells("File_Size").value & "," &
                                            File.cells("Image_Width").value & "," &
                                            File.cells("Image_Height").value & vbNewLine
                Next
            Else
                For Each Folder In Search_Result_DGV.SelectedRows
                    TextToWrite &= Folder.cells("File_Path").value & vbCrLf
                Next

                OpenFileDialog.FileName = MagNoteFolderPath & "\MagNoteDesktopWallpaper.fil"
                If File.Exists(OpenFileDialog.FileName) Then
                    My.Computer.FileSystem.DeleteFile(OpenFileDialog.FileName, FileIO.UIOption.OnlyErrorDialogs, FileIO.RecycleOption.SendToRecycleBin)
                End If

            End If
            My.Computer.FileSystem.WriteAllText(OpenFileDialog.FileName, TextToWrite, 0, System.Text.Encoding.UTF8)
            TextToWrite = String.Empty

        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

    Private Sub Load_Saved_Search_Result_Btn_Click(sender As Object, e As EventArgs) Handles Load_Saved_Search_Result_Btn.Click
        Me.Cursor = Cursors.WaitCursor
        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Try
            AddAlertFilesDGVColumn(Search_Result_DGV)
            Dim OpenFileDialog As New OpenFileDialog
            OpenFileDialog.Title = "Load Available Files"
            OpenFileDialog.Filter = "Data File|*.Fil|All files|*.*"
            OpenFileDialog.Multiselect = False
            OpenFileDialog.FileName = ""
            OpenFileDialog.RestoreDirectory = True
            If OpenFileDialog.ShowDialog = DialogResult.Cancel Then
                Exit Sub
            End If
            Dim TextToRead()
            TextToRead = My.Computer.FileSystem.ReadAllText(OpenFileDialog.FileName, System.Text.Encoding.UTF8).Split(delimiters, StringSplitOptions.None)
            Dim TextToWrite As String
            Search_Result_DGV.Rows.Clear()
            Dim ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, TextToRead.Count)
            For Each FilePath In TextToRead
                Me.Cursor = Cursors.WaitCursor
                progress += ProgressToAdd
                Previewlbl.Text = "Adding--> " & FilePath & vbNewLine & Math.Floor(progress * 100)
                Previewlbl.Refresh()
                Previewlbl.Invalidate()
                If String.IsNullOrEmpty(FilePath) Then Continue For
                If Split(FilePath, ",").ToList.Count > 1 Then
                    Search_Result_DGV.Rows.Add(Split(FilePath, ",").ToList.Item(0),
                                                                                Split(FilePath, ",").ToList.Item(1),
                                                                                Split(FilePath, ",").ToList.Item(2),
                                                                                Split(FilePath, ",").ToList.Item(3),
                                                                                Split(FilePath, ",").ToList.Item(4))
                ElseIf Split(FilePath, ",").ToList.Count = 1 Then
                    Search_Result_DGV.Rows.Add(FilePath)
                End If
                ApplicationDoEvents(Me)
            Next
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False,,,,,,, 0)
        Finally
            Me.Cursor = Cursors.Default
            PreviewPnl.Visible = False
            PreviewPnl.Dispose()
        End Try
    End Sub

