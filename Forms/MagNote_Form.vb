                ElseIf Microsoft.VisualBasic.Left(Note, Len("Use_Password_For_Update_Only -(")) & Microsoft.VisualBasic.Right(Note, 2) = "Use_Password_For_Update_Only -()-" Then
                    ReadNote = "Use_Password_For_Update_Only"
