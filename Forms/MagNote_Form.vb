    Public Sub NewLoadList(ByVal ShorcutTbPgName As String, Optional AnotherForm As Form = Nothing)
        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Dim ErrorMag As String
        Try
            Using XMLEditor As New XMLEditor("MagNoteShortcuts.xml", "MagNoteShortcuts")
                Dim ElmntRoot = XMLEditor.Element_Exist("MagNoteShortcuts", Nothing,, 1)
                If Not String.IsNullOrEmpty(ShorcutTbPgName) Then
                    ElmntRoot = XMLEditor.Element_Exist("MagNoteShortcuts", New Dictionary(Of String, String) From {{"MagNoteShortcuts", Replace(ShorcutTbPgName, Space(1), "_")}}, , 1)
                End If
                Try
                    Dim iterator As Object = ElmntRoot
                    Dim count As Integer
                    If TypeOf iterator Is IEnumerable(Of XElement) Then
                        count = DirectCast(iterator, IEnumerable(Of XElement)).Count()
                    Else
                        count = 0
                    End If
                    Dim ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, count, AnotherForm)
                    Dim CrrntShrtCutTbPg As String
                    For Each entry In ElmntRoot
                        Dim TbPgName = Replace(entry.name.ToString, "_", " ")
                        If String.IsNullOrEmpty(CrrntShrtCutTbPg) Or
                            TbPgName <> CrrntShrtCutTbPg Then
                            CrrntShrtCutTbPg = TbPgName
                        Else
                            Continue For
                        End If
                        Dim Label = entry.Element("Label")?.Value
                        Dim Path = entry.Element("Path")?.Value
                        progress += ProgressToAdd
                        Previewlbl.Text = "Loading--> " & Label & vbNewLine & Math.Floor(progress * 100)
                        Previewlbl.Refresh()
                        Previewlbl.Invalidate()
                        Dim newTab As New TabPage(TbPgName)
                        newTab.Name = TbPgName
                        If ShortCut_TbCntrl.TabPages.Count = 0 Or
                            Not ShortCut_TbCntrl.TabPages.Cast(Of TabPage)().Any(Function(t) t.Name = TbPgName) Then
                            Me.ShortCut_TbCntrl.TabPages.Add(TbPgName, TbPgName)
                            CType(ShortCut_TbCntrl, TabControl).TabPages(TbPgName).AllowDrop = True
                            AddHandlerMenuStripToControl(Me.ShortCut_TbCntrl.TabPages(TbPgName))
                        End If
                        'FilePath = MagNoteFolderPath & "\" & Replace(TbPgName, "_", " ") & "_(Shortcuts_links).txt"
                        LoadShortcutListFiles(CType(ShortCut_TbCntrl.TabPages(TbPgName).Controls(TbPgName), ListView), ElmntRoot, TbPgName, AnotherForm)
                    Next
                    Dim DTTbPb = New TabPage("My Desktop")
                    DTTbPb.Name = "My Desktop"
                    If ShortCut_TbCntrl.TabPages.Count = 0 Or
                            Not ShortCut_TbCntrl.TabPages.Cast(Of TabPage)().Any(Function(t) t.Name = "My Desktop") Then
                        CreatMyDesktopTabPage()
                    End If

                Catch ex As Exception
                End Try
            End Using
        Catch ex As Exception
            ShowMsg(ErrorMag & vbNewLine & ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Cursor = Cursors.Default
            PreviewPnl.Visible = False
            PreviewPnl.Dispose()
        End Try
    End Sub

