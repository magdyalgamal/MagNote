                        Reminder_Every_Value = Microsoft.VisualBasic.Left(Reminder_Every_Value, Reminder_Every_Value.Length - 2)
                        Reminder_Every = Reminder_Every_Value
                        ReadNote = String.Empty
                    Case "MagNote_Grid"
