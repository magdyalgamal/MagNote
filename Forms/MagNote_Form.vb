    Private Sub LoadOpenedTabPages()
        If Without_Opened_Notes_At_Startup_ChkBx.CheckState = CheckState.Checked Or
            Remember_Opened_Notes_When_Close_ChkBx.CheckState = CheckState.Unchecked Then
            Exit Sub
        End If
        Cursor = Cursors.WaitCursor
        Dim OSINT_ChkBx As CheckState = Open_Note_In_New_Tab_ChkBx.CheckState
        Dim Actvcntrl = ActiveControl
        Try
            Open_Note_In_New_Tab_ChkBx.CheckState = CheckState.Checked
            Using XMLEditor As New XMLEditor("NewCategories.xml", "Category_Entries")
                Dim OpenedMaagotes = XMLEditor.doc.<Category_Entries>.Elements().Where(Function(e) CStr(e.<Opened>.FirstOrDefault()) = "1")
                If OpenedMaagotes IsNot Nothing Then
                    For Each Elmnt In OpenedMaagotes
                        SetMagNoteNoCmbBxFocused()
                        AddLoadOpenedTabPages(Elmnt.<Path>.Value)
                    Next
                Else
                    Exit Sub
                End If
            End Using
            If Language_Btn.Text = "E" Then
