    Private Sub Shortcuts_LstVw_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Dim ShortcutLinkTxtBx
        Try
            Dim LinkName = sender.SelectedItems(0).Tag
            Cursor = Cursors.WaitCursor
            If MouseDounRight Then Exit Sub
            If Double_Click_To_Run_Shortcut_ChkBx.CheckState = CheckState.Checked Then Exit Sub
            If Not IsNothing(sender.SelectedItems(0).Tag) Then
                Try
                    Dim Objct As Object = DirectCast(sender, System.Windows.Forms.ListView).FocusedItem
                    ShortcutLinkTxtBx = Shortcut_Propertis_Form.GetShortcutTargetFile(Objct.Tag).ToString
                    Dim di As System.IO.DirectoryInfo
                    If Not String.IsNullOrEmpty(ShortcutLinkTxtBx) Then
                        If Directory.Exists(ShortcutLinkTxtBx) Then
                            di = New System.IO.DirectoryInfo(Path.GetDirectoryName(ShortcutLinkTxtBx))
                            Dim dirs As System.IO.FileSystemInfo() = di.GetDirectories("*")
                        End If
                    End If
                Catch ex As Exception
                    ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
                    Exit Sub
                End Try
                Process.Start(sender.SelectedItems(0).Tag)
                If Minimize_After_Running_My_Shortcut_ChkBx.CheckState <> CheckState.Unchecked Then
                    MyFormWindowState(0, 0, Nothing, Convert.ToBoolean(Minimize_After_Running_My_Shortcut_ChkBx.CheckState))
                End If
            End If
        Catch ex As Exception
            If ex.Message.Contains("The operation was canceled by the user") Then
                Try
                    Dim files = IO.Directory.GetFiles(Path.GetDirectoryName(ShortcutLinkTxtBx))
                Catch ex1 As Exception
                    ShowMsg(ex1.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
                End Try
            Else
                ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
            End If
        Finally
