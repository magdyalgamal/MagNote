    Public Function PaintFindForm(form As Form) As Boolean
        If Not form.Visible Then Exit Function
        form.Opacity = Form_Transparency_TrkBr.Value / 100
        For Each cntrl In FindControlRecursive(New List(Of Control), form, New List(Of Type))
            Try
                If IgnoreForeBackground(cntrl) Then
