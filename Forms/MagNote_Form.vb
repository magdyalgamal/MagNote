    Private Sub ShortCut_TbCntrl_SelectedIndexChanged(sender As Object, e As EventArgs) Handles ShortCut_TbCntrl.SelectedIndexChanged
        Try
            If IsNothing(ShortCut_TbCntrl.Controls(ShortCut_TbCntrl.SelectedTab.Name).Controls(ShortCut_TbCntrl.SelectedTab.Name)) Then
                Exit Sub
            End If
            Shortcuts_LstVw = CType(ShortCut_TbCntrl.Controls(ShortCut_TbCntrl.SelectedTab.Name).Controls(ShortCut_TbCntrl.SelectedTab.Name), ListView)
            Dim OpenWithDeleteFile As String = String.Empty
            If ShortCut_TbCntrl.SelectedTab.Name = "My Desktop" Then
                For Each item In Shortcuts_LstVw.ContextMenuStrip.Items
                    If item.name = "Open_With" Then
                        OpenWithDeleteFile &= "Open_With"
                    ElseIf item.name = "Delete_File" Then
                        OpenWithDeleteFile &= "Delete_File"
                    End If
                Next
                If OpenWithDeleteFile.Contains("Open_With") And
                    OpenWithDeleteFile.Contains("Delete_File") Then
                    Exit Sub
                End If
                '-------------------------------------------------------------
                Dim Open_With As New ToolStripMenuItem
                If Language_Btn.Text = "ع" Then
                    Open_With.Text = "Open With"
                Else
                    Open_With.Text = "تشغيل مع"
                End If
                Open_With.Name = "Open_With"
                Open_With.Tag = MagNotes_Notes_TbCntrl.Name
                Open_With.Image = My.Resources.OpenWith
                Open_With.BackgroundImage = My.Resources.Background4
                Shortcuts_LstVw.ContextMenuStrip.Items.Add(Open_With)
                Open_With.BackgroundImageLayout = System.Windows.Forms.ImageLayout.Stretch
                AddHandler Open_With.Click, AddressOf Open_With_Click
                '-------------------------------------------------------------
                Dim Delete_File As New ToolStripMenuItem
                If Language_Btn.Text = "ع" Then
                    Delete_File.Text = "Delete File"
                Else
                    Delete_File.Text = "إلغاء الملف"
                End If
                Delete_File.Name = "Delete_File"
                Delete_File.Tag = MagNotes_Notes_TbCntrl.Name
                Delete_File.Image = My.Resources.recyclebin
                Delete_File.BackgroundImage = My.Resources.Background4
                Shortcuts_LstVw.ContextMenuStrip.Items.Add(Delete_File)
                Delete_File.BackgroundImageLayout = System.Windows.Forms.ImageLayout.Stretch
                AddHandler Delete_File.Click, AddressOf Delete_File_Click
            Else
                For Each item In Shortcuts_LstVw.ContextMenuStrip.Items
                    If item.name = "Open_With" Or
                        item.name = "Delete_File" Then
                        Shortcuts_LstVw.ContextMenuStrip.Items.Remove(item)
                        Exit For
                    End If
                Next
            End If

        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

