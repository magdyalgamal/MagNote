    Public CurrentDGVRow As DataGridViewRow
    Public Sub Available_MagNotes_DGV_SelectionChanged(sender As Object, e As EventArgs) Handles Available_MagNotes_DGV.SelectionChanged
        Try
            If sender.MultiSelect = True Then Exit Sub
            Cursor = Cursors.WaitCursor
            SaveDialogResultAnseredIsNo = False
            Dim ShowNote As String = String.Empty
            If IsNothing(ActiveControl) Or
                sender.SelectedRows.Count = 0 Or
                IsNothing(MagNotes_Notes_TbCntrl.SelectedTab) Then
                Exit Sub
            End If
            If CurrentRowNotEqualRowIndex(sender, 1) Then
                Exit Sub
            End If

            If MagNotes_Notes_TbCntrl.SelectedTab.Name <> sender.CurrentRow.Cells("MagNote_Name").Value Then
                For Each tabPage As TabPage In MagNotes_Notes_TbCntrl.TabPages
                    If tabPage.Name = sender.CurrentRow.Cells("MagNote_Name").Value Then
                        MagNotes_Notes_TbCntrl.SelectedTab = tabPage
                        Exit Sub
                    End If
                Next
            End If

            If ActiveControl.Name = Note_Password_TxtBx.Name Then
                ShowNote = "ShowWithDecrypt"
            End If
            If CommingFromSaveToolStripButton Then GoTo CFSTSB
            If Not IsNothing(sender.CurrentRow) Then
                If sender.CurrentRow.Selected Then
                    CurrentDGVRow = sender.CurrentRow
                End If
            End If
            If (ActiveControl.Name <> sender.name And
                ActiveControl.Name <> Previous_Btn.Name And
                ActiveControl.Name <> Next_Btn.Name And
                ActiveControl.Name <> MagNote_No_CmbBx.Name) And
                Not ExitingProgram Then
                Exit Sub
            End If
            If IsNothing(CurrentDGVRow) Or
                 ExitingProgram Then
                Exit Sub
            End If
CFSTSB:
            If MagNotes_Notes_TbCntrl.SelectedTab.Tag <> sender.CurrentRow.Cells("MagNote_Name").Value And ActiveControl.Name <> sender.Name Then
                Exit Sub
            ElseIf ActiveControl.Name = sender.Name Then
                If Not IsInMagNoteCmbBx(sender.CurrentRow.Cells("MagNote_Name").Value, 1) Then
                    ReadFile(sender.CurrentRow.Cells("MagNote_Name").Value,,,,, 1)
                    Exit Sub
                End If
            End If
            ApplicationDoEvents(Me)
            If ActiveControl.Name = sender.name Then
                RefreshMagNoteSetting(, sender.CurrentRow, 1, ShowNote)
                If Save_MagNote_Cursor_Position_When_Exit_ChkBx.CheckState = CheckState.Checked Then
                    If Not String.IsNullOrEmpty(sender.CurrentRow.Cells("Cursor_Position").Value) Then
                        RCSN(0).SelectionStart = Val(sender.CurrentRow.Cells("Cursor_Position").Value)
                    End If
                End If
                Try
                    If Not String.IsNullOrEmpty(sender.CurrentRow.Cells("MagNote_Height").Value) Then
                        RCSN(0).Height = Val(sender.CurrentRow.Cells("MagNote_Height").Value)
                    End If
                Catch ex As Exception
                End Try
            Else
                'RefreshMagNoteSetting(, sender.CurrentRow, 0, ShowNote)
            End If
            ApplicationDoEvents(Me)
            CheckNextReminderTime()
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Cursor = Cursors.Default
            If sender.SelectedRows.Count = 0 Then
                CurrentDGVRow = Nothing
            End If
        End Try
    End Sub
    Public Function CheckNextReminderTime() As Boolean
        Try
            If IsNothing(Available_MagNotes_DGV.CurrentRow) Then
                Exit Function
            End If
            If Not String.IsNullOrEmpty(Available_MagNotes_DGV.CurrentRow.Cells("Next_Reminder_Time").Value.ToString) Then
                Dim dt As DateTime = DateTime.ParseExact(Available_MagNotes_DGV.CurrentRow.Cells("Next_Reminder_Time").Value, "yyyy-MM-dd HH-mm-ss", CultureInfo.InvariantCulture)
                If Next_Reminder_Time_DtTmPkr.Value <> dt Then
                    ApplicationDoEvents(Me)
                    Dim x = 1
                End If
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function
