    Private Sub MagNotes_Notes_TbCntrl_Deselecting(sender As Object, e As TabControlCancelEventArgs) Handles MagNotes_Notes_TbCntrl.Deselecting
        Try
            If IsNothing(ActiveControl) Or
                IsNothing(e.TabPage) Or
                Check_If_Changed_Before_Go_To_Another_TbPg_ChkBx.CheckState = CheckState.Unchecked Then
                Exit Sub
            End If
            If ActiveControl.Name <> MagNotes_Notes_TbCntrl.Name Or
            Delete_Note_TlStrpBtn.Checked Then
                Exit Sub
            End If
            If MagNote_No_CmbBx.SelectedIndex <> 1 Then
                If DirectCast(MagNote_No_CmbBx.SelectedItem, KeyValuePair(Of String, String)).Key <> MagNotes_Notes_TbCntrl.SelectedTab.Name Then
                    Exit Sub
                End If
            End If
            Dim Nm = e.TabPage.Text
            Dim MyDialogResult = NoteAmendmented(MagNotes_Notes_TbCntrl.SelectedTab.Name)
            If MyDialogResult <> DialogResult.Cancel And
            MyDialogResult <> DialogResult.None Then
                e.Cancel = True
            End If
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Sub

