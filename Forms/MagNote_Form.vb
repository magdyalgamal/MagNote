    Private Function ChangeChkBxStatus() As Boolean
        Dim PctrBxNm, ChkBxNm
        Dim foundCheckBox, PctrCheckBox As CheckBox
        Dim PctrBx As PictureBox
        For x = 1 To 21
            PctrBxNm = "PctrBxNm_" & x & "_PctrBx"
            ChkBxNm = Replace(PctrBxNm, "PctrBx", "ChkBx")
            Try
                PctrBx = FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, PctrBxNm).ToList.Item(0)
                foundCheckBox = SelectedImagesChkBx.FirstOrDefault(Function(chk) chk.Name = PctrBx.Tag)
            Catch ex As Exception
                Continue For
            End Try
            If Not IsNothing(foundCheckBox) Then
                CType(FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, ChkBxNm).ToList.Item(0), CheckBox).CheckState = foundCheckBox.CheckState
                Continue For
            End If
            Try
                PctrCheckBox = FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, ChkBxNm).ToList.Item(0)
                PctrCheckBox.CheckState = CheckState.Unchecked
            Catch ex As Exception
                Continue For
            End Try
        Next
    End Function
