                    MagNote_No_CmbBx.SelectedIndex = -1
                    MagNote_No_CmbBx.Text = SelectedItem
                End If
                Try
                    CType(MagNoteRTF(Array.FindIndex(MagNoteRTF, Function(f) f.Name = RCSN.Name)), RichTextBox).Rtf = RCSN.Rtf
                Catch ex As Exception
                    ShowMsg("While Save RCSN.Rtf" & vbNewLine & ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
