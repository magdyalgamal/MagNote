    Private Function MoveSelectedRowsToFirstRow(matchedRow As DataGridViewRow) As Boolean
        ' Move the row to the top if found
        Try
            If matchedRow IsNot Nothing Then
                Dim index As Integer = matchedRow.Index
                ' Clone the row
                Dim newRow As DataGridViewRow = CType(matchedRow.Clone(), DataGridViewRow)
                For i As Integer = 0 To matchedRow.Cells.Count - 1
                    newRow.Cells(i).Value = matchedRow.Cells(i).Value
                Next
                ' Insert at top and remove original
                My_Contacts_List_DGV.Rows.Insert(0, newRow)
                My_Contacts_List_DGV.Rows.RemoveAt(index + 1) ' +1 because the insert shifts indices
                My_Contacts_List_DGV.ClearSelection()
                My_Contacts_List_DGV.Rows(0).Selected = True
            End If
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        End Try
    End Function
