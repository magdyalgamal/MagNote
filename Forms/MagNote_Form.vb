    Private Sub Send_WhatsApp_Message_Btn_Click(sender As Object, e As EventArgs) Handles Send_WhatsApp_Message_Btn.Click
        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Try
            Me.Cursor = Cursors.WaitCursor
            If Not IsConnectedToInternet() Then Exit Sub
            If FillObjectsFirest(1) Then Exit Sub
            Phone_Numbers_Failed_Sending_Its_Messages_TxtBx.Text = Nothing
            If Phone_Nmber_TxtBx.TextLength = 0 Or
                API_Token_Insance_TxtBx.TextLength = 0 Or
                ID_Instance_TxtBx.TextLength = 0 Then
                If Language_Btn.Text = "E" Then
                    Msg = "يرجى ملء العناصر المطلوبة لإرسال الرسالة"
                Else
                    Msg = "Kindly Fill The Needed Fields To Send The Message"
                End If
                ShowMsg(Msg & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
                Exit Sub
            End If
            Phone_Nmber_TxtBx.Text = Replace(Replace(Phone_Nmber_TxtBx.Text, Space(1), ""), "+", "")
            Dim ErrorResponse As String = String.Empty
            Dim response As String
            Dim files As New List(Of String)
            If WhatsApp_Attach_File_ChkBx.CheckState = CheckState.Checked Then
                If File.Exists(WhatsApp_Attach_File_TxtBx.Text) Then
                    files.Add(WhatsApp_Attach_File_TxtBx.Text)
                Else
                    If File.Exists("DumyFile.txt") Then
                        File.Delete("DumyFile.txt")
                    End If
                    My.Computer.FileSystem.WriteAllText("DumyFile.txt", "", 0, System.Text.Encoding.UTF8)
                    files.Add("DumyFile.txt")
                End If
            End If
            Dim ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, Phone_Nmber_TxtBx.Text.Split(",").ToList.Count)
            For Each PhoneNumber In Phone_Nmber_TxtBx.Text.Split(",")
                progress += ProgressToAdd
                Previewlbl.Text = "Sending WhatsApp Message To --> " & PhoneNumber & vbNewLine & Math.Floor(progress * 100)
                Previewlbl.Refresh()
                Previewlbl.Invalidate()
                Using GreenAPISender As New GreenApiFileUploader(ID_Instance_TxtBx.Text, API_Token_Insance_TxtBx.Text)
                    If Not PhoneNumber.EndsWith("@g.us") And
                        Not PhoneNumber.EndsWith("@c.us") Then
                        PhoneNumber &= "@c.us"
                    End If
                    GreenAPISender.SendWhatsApMessage(ID_Instance_TxtBx.Text, API_Token_Insance_TxtBx.Text, PhoneNumber, files, RCSN(0).Text)
                End Using
            Next
            If Phone_Numbers_Failed_Sending_Its_Messages_TxtBx.TextLength > 0 Then
                If Language_Btn.Text = "E" Then
                    Msg = "لم يتم ارسال جميع الرسائل بنجح... من فضلك راجع عنصر أرقام المحاولات الفاشلة"
                Else
                    Msg = "Not all messages were sent successfully... Please check the object (Phone Numbers Failed Sending Its Messages)"
                End If
                ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification)
            Else
                If Language_Btn.Text = "E" Then
                    Msg = "تم إرسال الرسالة بنجاح"
                Else
                    Msg = "Message Already Sent Successfully"
                End If
                ShowMsg(Msg, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification,)
            End If
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Me.Cursor = Cursors.Default
            PreviewPnl.Dispose()
            Previewlbl.Dispose()
        End Try
    End Sub

