                    Else
                        Alert_Type_CmbBx.Items.Add(New KeyValuePair(Of String, String)(0, "Normal"))
                        Alert_Type_CmbBx.Items.Add(New KeyValuePair(Of String, String)(1, "Weekly"))
                        Alert_Type_CmbBx.Items.Add(New KeyValuePair(Of String, String)(2, "Monthly"))
                        Alert_Type_CmbBx.Items.Add(New KeyValuePair(Of String, String)(3, "Yearly"))
                    End If
                End If
