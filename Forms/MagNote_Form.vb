            If Language_Btn.Text = "E" Then
                Msg = "لم يتم إعداد إعدادات إرسال البريد الالكترونى بعد"
            Else
                Msg = "eMail Setting Not Prepared Yet"
            End If
            ShowMsg(Msg,, MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2)
