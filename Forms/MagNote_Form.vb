    Private Sub Preview_Down_Btn_Click(sender As Object, e As EventArgs) Handles Preview_Down_Btn.Click
        Try
            Me.Cursor = Cursors.AppStarting
            If (Search_Result_DGV.Rows.Count - 1 = Search_Result_DGV.CurrentRow.Index) Then
                Exit Sub
            End If
            PrepareShotcutPictureBoxes()
            Dim PctrBxNm, StrtFrm, PicNm, Stp
            If (Search_Result_DGV.CurrentRow.Index + 20) <= Search_Result_DGV.Rows.Count Then
                Stp = Search_Result_DGV.CurrentRow.Index + 20
            Else
                Stp = Search_Result_DGV.Rows.Count - 1
            End If
            Dim foundCheckBox As CheckBox
            If Search_Result_DGV.SelectedRows.Count = 0 Then
                For Pic = 1 To Stp
                    PctrBxNm = "PctrBxNm_" & Pic & "_PctrBx"
                    CType(FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, PctrBxNm).ToList.Item(0), PictureBox).Image = Image.FromFile(Search_Result_DGV.Rows(Pic).Cells("File_Path").Value)
                    CType(FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, PctrBxNm).ToList.Item(0), PictureBox).Tag = Search_Result_DGV.Rows(Pic).Cells("File_Path").Value
                Next
                ChangeChkBxStatus()
                SelectAvailableMagNotesDGV(20, Search_Result_DGV)
            ElseIf Search_Result_DGV.Rows.Count - 1 = Search_Result_DGV.CurrentRow.Index Then
                Exit Sub
            Else
                StrtFrm = Search_Result_DGV.CurrentRow.Index
                PicNm = 1
                Dim RemovePctrs = Stp - StrtFrm
                If RemovePctrs <> 20 Then
