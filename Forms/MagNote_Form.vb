    Public Function RCSNHasDifferentFontColor(rtb As RichTextBox) As Boolean

        If rtb.SelectionLength = 0 Then
            Return True
        End If
        Dim SlctdTxtlngt = rtb.SelectionLength
        Dim SlctnStrt = rtb.SelectionStart
        Try
            For i As Integer = SlctnStrt To (SlctnStrt + SlctdTxtlngt) - 1
                rtb.Select(i, 1)
                If rtb.SelectionBackColor <> Note_Back_Color_ClrCmbBx.SelectedItem Or
                    rtb.SelectionColor <> Note_Font_Color_ClrCmbBx.SelectedItem Then
                    rtb.SelectionLength = 0
                    Return True
                End If
            Next
            Return False
        Finally
            rtb.SelectionStart = SlctnStrt
            rtb.SelectionLength = SlctdTxtlngt
            RCSN(0).Focus()
        End Try
    End Function
    Public Sub ChangeRichTextBoxFontAndPreserveBackground(rtb As RichTextBox, newFont As Font)

        Dim PreviewPnl As New Panel
        Dim Previewlbl As New Label
        Try
            Me.Cursor = Cursors.WaitCursor
            Dim RtchTxtBx As New RichTextBox
            'RtchTxtBx.Rtf = rtb.Rtf
            RtchTxtBx = rtb
            Dim currentSelectionStart As Integer = rtb.SelectionStart
            Dim currentSelectionLength As Integer = rtb.SelectionLength
            Dim ProgressToAdd = AddCustomProgresBar(PreviewPnl, Previewlbl, RtchTxtBx.TextLength - 1)
            Dim currentBackColor As Color = RtchTxtBx.BackColor
            Dim currentFontColor As Color = RtchTxtBx.SelectionColor
            Dim UpTo = rtb.Text.Length
            If rtb.SelectionLength > 0 Then
                UpTo = rtb.SelectionStart + rtb.SelectionLength
            End If
            For i As Integer = rtb.SelectionStart To UpTo - 1
                Me.Cursor = Cursors.WaitCursor
                progress += ProgressToAdd
                Previewlbl.Text = "Changing Font Properties--> " & Math.Floor(progress * 100)
                Previewlbl.Refresh()
                Previewlbl.Invalidate()

                rtb.Select(i, 1)
                RtchTxtBx.Select(i, 1)
                currentBackColor = rtb.SelectionBackColor
                currentFontColor = rtb.SelectionColor
                RtchTxtBx.SelectionFont = newFont
                If RtchTxtBx.SelectionBackColor.ToArgb <> currentBackColor.ToArgb Then
                    RtchTxtBx.SelectionBackColor = currentBackColor
                End If
                If RtchTxtBx.SelectionColor.ToArgb <> currentFontColor.ToArgb Then
                    RtchTxtBx.SelectionColor = currentFontColor
                End If
            Next
            If UpTo <> rtb.Text.Length Then
                rtb.SelectionStart = currentSelectionStart
                rtb.SelectionLength = currentSelectionLength
            End If
            rtb.Rtf = RtchTxtBx.Rtf
        Catch ex As Exception
            ShowMsg(ex.Message & CurrentMagNote(), "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False)
        Finally
            Cursor = Cursors.Default
            PreviewPnl.Visible = False
            PreviewPnl.Dispose()
        End Try
    End Sub
