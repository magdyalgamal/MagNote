    Private Function ReEncryptMagNote() As Boolean
        Try
            If Language_Btn.Text = "E" Then
                Msg = "سيتم اعادة حفظ جميع الماجنوتات المحفوظة سابقاً بإستخدام مفتاح التشفر الجديد أعتمادا على حالة العنصر ـ(تحديث تشفير الماجنوتات المفتوحة فقط)ـ ... هل أنت متأكد؟"
            Else
                Msg = "All Previous Saved MagNotes Will Be Saved Again Using The New Encryption Key Depending On The Status Of The Object (Update Only Opened MagNotes Encryption Key)... Are You Sure?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                Encryption_Key_TxtBx.Text = EncryptionKey
                Exit Function
            End If
            If ChangeMagNoteEncryptionKey() Then
                If Update_Only_Opened_TabPages_Encryption_Key_ChkBx.CheckState = CheckState.Unchecked Then
                    Save_Note_Form_Parameter_Setting_Btn_Click(Save_Note_Form_Parameter_Setting_Btn, EventArgs.Empty, 0)
                    AddModifyAppSetting("EncryptionKey", Encryption_Key_TxtBx.Text)
                    ApplicationRestart = True
                    Close()
                    ApplicationDoEvents(Me)
                    Application.Restart()
                End If
            End If
            'End If
        Catch ex As Exception
            ShowMsg(ex.Message, "InfoSysMe (MagNote)", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button2, MessageBoxOptions.ServiceNotification, False) ', 0,,,,,, 0)
        End Try
    End Function
