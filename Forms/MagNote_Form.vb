    Private Function DisposePctrBxs(Optional ByVal StrtFrm As String = Nothing, Optional ByVal ClearChkBxStatus As Boolean = False) As Boolean
        If ClearChkBxStatus Then GoTo RunClearChkBxStatus
        If String.IsNullOrEmpty(StrtFrm) Then
            StrtFrm = 1
        End If
        If FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, "PctrBxNm_1_PctrBx").Count = 0 Then Exit Function
        For x = Val(StrtFrm) To 21
            Try
                FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, "PctrBxNm_" & x & "_PctrBx").ToList.Item(0).Dispose()
                FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, "ChkBxNm_" & x & "_ChkBx").ToList.Item(0).Dispose()
            Catch ex As Exception
            End Try
        Next
        If StrtFrm = 1 Then
RunClearChkBxStatus:
            ReDim SelectedImagesChkBx(0)
        End If
    End Function
    Dim SelectedImagesChkBx() As CheckBox
    Private Sub SelectedImagegChkBx_CheckStateChanged(sender As Object, e As EventArgs)
        Dim foundCheckBox As CheckBox
        If Not IsNothing(ActiveControl) Then
            If ActiveControl.Name <> sender.name Then
                Exit Sub
            End If
        Else
            Exit Sub
        End If
        Try
            foundCheckBox = SelectedImagesChkBx.FirstOrDefault(Function(chk) chk.Name = sender.Name)
        Catch ex As Exception
        End Try
        If sender.CheckState = CheckState.Checked Then
            If IsNothing(foundCheckBox) Then
                If IsNothing(SelectedImagesChkBx) Then
                    ReDim Preserve SelectedImagesChkBx(0)
                ElseIf Not IsNothing(SelectedImagesChkBx(0)) Then
                    ReDim Preserve SelectedImagesChkBx(SelectedImagesChkBx.Length)
                End If
                SelectedImagesChkBx(SelectedImagesChkBx.Count - 1) = New CheckBox
                SelectedImagesChkBx(SelectedImagesChkBx.Count - 1).CheckState = sender.CheckState
                Dim Nm = CType(FindControlRecursive(New List(Of Control), Wallpaper_PctrBx_Pnl, New List(Of Type),, Replace(sender.name, "ChkBx", "PctrBx")).ToList.Item(0), PictureBox).Tag
                SelectedImagesChkBx(SelectedImagesChkBx.Count - 1).Name = Nm
            End If
        Else
            If Not IsNothing(foundCheckBox) Then
                SelectedImagesChkBx = SelectedImagesChkBx.Where(Function(chk) chk.Name <> sender.Name).ToArray()
            End If
        End If
    End Sub

