        If Encryption_Key_TxtBx.TextLength = 0 Then Exit Sub
        If Encryption_Key_TxtBx.Text <> EncryptionKey Then
            If Language_Btn.Text = "E" Then
                Msg = "تعديل مفاح التشفير معناه ان يتم اعادة حفظ جميع الماجنوتات المحفوظة سابقاً بإستخدام مفتاح التشفير الجديد... هل أنت متأكد؟"
            Else
                Msg = "Modifying The Encryption Key Means That All Previous Saved MagNotes Will Be Saved Again Using The New Encryption Key... Are You Sure?"
            End If
            If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                Encryption_Key_TxtBx.Text = EncryptionKey
                e.Cancel = True
                Exit Sub
            Else
                If Language_Btn.Text = "E" Then
                    Msg = "سيتم اعادة حفظ جميع الماجنوتات المحفوظة سابقاً بإستخدام مفتاح التشفر الجديد... هل أنت متأكد؟"
                Else
                    Msg = "All Previous Saved MagNotes Will Be Saved Again Using The New Encryption Key... Are You Sure?"
                End If
                If ShowMsg(Msg,, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                    Encryption_Key_TxtBx.Text = EncryptionKey
                    e.Cancel = True
                    Exit Sub
                End If
                Encryption_Key_TxtBx.UseSystemPasswordChar = True
            End If
        End If

