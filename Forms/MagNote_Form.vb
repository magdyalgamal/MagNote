    Private Sub SetDesktopIconsVisibility(hide As Boolean)
        ' Access the registry key
        Dim regKey As RegistryKey = Registry.CurrentUser.OpenSubKey("Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced", True)

        If regKey IsNot Nothing Then
            ' Set HideIcons value: 1 to hide, 0 to show
            regKey.SetValue("HideIcons", If(hide, 1, 0), RegistryValueKind.DWord)
            regKey.Close()

            ' Refresh the desktop to apply changes
            RefreshDesktop()
        Else
            MessageBox.Show("Failed to access registry key.")
        End If
    End Sub

    Private Sub RefreshDesktop()
        ' Use Windows API to refresh the desktop
        SHChangeNotify(&H8000000, &H1000, IntPtr.Zero, IntPtr.Zero)
    End Sub

