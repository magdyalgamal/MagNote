    Private Sub OnSessionEnding(sender As Object, e As SessionEndingEventArgs)
        If e.Reason = SessionEndReasons.Logoff Then
            MessageBox.Show("User is logging off!")
        ElseIf e.Reason = SessionEndReasons.SystemShutdown Then
            MessageBox.Show("System is shutting down!")
        End If
    End Sub

    ' Handle session switch (logon or logoff events)
    Private Sub OnSessionSwitch(sender As Object, e As SessionSwitchEventArgs)
        Select Case e.Reason
            Case SessionSwitchReason.SessionLogon
                Debug.Print("User has logged on!")
            Case SessionSwitchReason.SessionLogoff
                Debug.Print("User has logged off!")
            Case SessionSwitchReason.RemoteConnect
                Debug.Print("User connected remotely!")
            Case SessionSwitchReason.RemoteDisconnect
                Debug.Print("User disconnected remotely!")
            Case SessionSwitchReason.SessionLock
                Debug.Print("The desktop is locked!")
            Case SessionSwitchReason.SessionUnlock
                If Ask_For_Password_If_User_Unlocked_ChkBx.CheckState = CheckState.Unchecked Then
                    Exit Sub
                End If
                Me.Enabled = False
                Me.Opacity = 0
                EnteredPassword = String.Empty
                Application_Initializing_Form.TopMost = True
                Application_Initializing_Form.Show(Me)
                Application_Initializing_Form.Activate()
                Application_Initializing_Form.User_Password_TxtBx.Focus()
                If Not PasswordOk() Then
                    Application.Exit()
                End If
                Me.Enabled = True
                Me.Opacity = Val(Note_Form_Opacity_TxtBx.Text)
        End Select
    End Sub
    Declare Function ShutdownBlockReasonCreate Lib "user32.dll" (ByVal hWnd As IntPtr, <Runtime.InteropServices.MarshalAs(Runtime.InteropServices.UnmanagedType.LPWStr)> ByVal reason As String) As Boolean
